#!/usr/bin/env python3
"""Build a secret-free surface folder and encrypted shadow copies of the vault."""

import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from datetime import datetime, timedelta
from pathlib import Path


sys.path.insert(0, str(Path(__file__).resolve().parent))
from vault_path import vault_root  # noqa: E402
import ship_token  # noqa: E402

VAULT = vault_root()
SURFACE = Path(os.path.expanduser(os.environ.get("BRAIN_SURFACE_DIR", "~/.local/share/brain/surface")))
COPIES = Path(os.path.expanduser(os.environ.get("BRAIN_SHADOW_DIR", "~/.local/share/brain/shadow")))
OPEN = Path(os.path.expanduser(os.environ.get("BRAIN_SHADOW_OPEN", "~/.local/share/brain/open")))
KEY = Path(os.path.expanduser(os.environ.get("BRAIN_SHADOW_KEY", "~/.config/brain/shadow.key")))

FRONTMATTER = re.compile(r"\A---\r?\n(.*?)\r?\n---", re.S)
INLINE_TAGS = re.compile(r"(?m)^tags:[ \t]*\[([^\]]*)\][ \t]*$")
PEM = re.compile(
    r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?-----END [A-Z0-9 ]*PRIVATE KEY-----",
    re.S,
)
CREDENTIAL = re.compile(
    r"(?im)^[^\n]*\b(?:password|passwd|api[_ ]?key|token|secret)\b[^\n]*?[:=][ \t]*([A-Za-z0-9+/=_.-]{8,})[ \t]*$"
)
EMAIL = re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b")
PHONE = re.compile(r"\b\d{3}[-.]\d{3}[-.]\d{4}\b")
STAMP = re.compile(r"^shadow-(\d{4}-\d{2}-\d{2}-\d{4})(?:-\d+)?$")
RECIPIENT = re.compile(r"age1[0-9a-z]+")
DAY_KEY = re.compile(r"(?m)^{}:[ \t]*(\d+)[ \t]*$")


@dataclass
class Config:
    vault: Path
    surface: Path
    copies: Path
    open: Path
    key: Path
    every_days: int = 30
    keep_days: int = 90
    install_agent: bool = True


class BuildFailed(Exception):
    pass


def env_for_tools():
    env = os.environ.copy()
    for name in ("NOTEDBRO_SHIP_TOKEN", "GITHUB_TOKEN", "GH_TOKEN"):
        env.pop(name, None)
    env["COPYFILE_DISABLE"] = "1"
    return env


def run_tool(args, **kwargs):
    return subprocess.run(args, env=env_for_tools(), **kwargs)


def require_tools():
    needed = ("tar", "zstd", "age", "age-keygen")
    missing = [name for name in needed if shutil.which(name) is None]
    if missing and shutil.which("brew"):
        subprocess.run(["brew", "install", "age", "zstd"], check=False)
        missing = [name for name in needed if shutil.which(name) is None]
    if missing:
        print("Cannot run shadow.")
        raise SystemExit(1)


def load_days(vault):
    path = vault / "Parameters.md"
    if not path.is_file():
        return 30, 90
    text = path.read_text()
    found = {}
    for key in ("shadow_every_days", "shadow_keep_days"):
        match = DAY_KEY.pattern.format(key)
        hit = re.search(match, text)
        if not hit:
            continue
        value = int(hit.group(1))
        if value < 1:
            raise SystemExit(f"Parameters.md: {key} must be at least 1")
        found[key] = value
    return found.get("shadow_every_days", 30), found.get("shadow_keep_days", 90)


def load_config():
    every, keep = load_days(VAULT)
    return Config(VAULT, SURFACE, COPIES, OPEN, KEY, every, keep)


def assert_outside(path, vault, label):
    resolved = path.resolve()
    root = vault.resolve()
    if resolved == root or root in resolved.parents:
        raise SystemExit(f"Refused to write inside the vault: {label}")
    if resolved == Path.home().resolve() or resolved == Path("/") or len(resolved.parts) < 4:
        raise SystemExit(f"Refused to write {label} at {resolved}")


def guard_outputs(cfg):
    assert_outside(cfg.surface, cfg.vault, "surface")
    assert_outside(cfg.copies, cfg.vault, "shadow")
    assert_outside(cfg.open, cfg.vault, "open folder")
    assert_outside(cfg.key, cfg.vault, "key")


def tags_of(frontmatter):
    match = INLINE_TAGS.search(frontmatter)
    if not match:
        return []
    return [part.strip() for part in match.group(1).split(",") if part.strip()]


def scalar_true(frontmatter, key):
    match = re.search(rf"(?m)^{re.escape(key)}:[ \t]*(.+)$", frontmatter)
    return bool(match) and match.group(1).strip().strip("\"'") in {"true", "yes"}


def marked_secret(text):
    match = FRONTMATTER.match(text)
    if not match:
        return False
    frontmatter = match.group(1)
    tags = set(tags_of(frontmatter))
    if "secret" in tags or "employee" in tags:
        return True
    return scalar_true(frontmatter, "secret") or scalar_true(frontmatter, "employee")


def withheld(rel, text):
    parts = rel.parts
    if parts and parts[0] == "Personal":
        return True
    if len(parts) >= 2 and parts[0] == "_Scripts" and parts[1] == "host-restore":
        return True
    if ".git" in parts:
        return True
    if rel.as_posix() == ".obsidian/workspace.json":
        return True
    if text is not None and marked_secret(text):
        return True
    return False


def redact(text):
    text = PEM.sub("[withheld]", text)
    lines = []
    for line in text.splitlines(keepends=True):
        if CREDENTIAL.search(line):
            newline = "\n" if line.endswith("\n") else ""
            lines.append("[withheld]" + newline)
        else:
            lines.append(line)
    return "".join(lines)


def leaks(text):
    found = []
    if PEM.search(text):
        found.append("private key")
    if CREDENTIAL.search(text):
        found.append("credential")
    if EMAIL.search(text):
        found.append("email")
    if PHONE.search(text):
        found.append("phone")
    return found


def iter_files(root):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        for name in sorted(filenames):
            path = Path(dirpath) / name
            if path.is_symlink() or path.is_file():
                yield path


def external_token_entry(path, vault):
    """Identify links or hard links to the managed token without reading its bytes."""
    try:
        token = ship_token.token_path()
        if not token.exists() or token.resolve() == Path(vault).resolve():
            return False
        return path.resolve() == token.resolve() or (path.is_file() and not path.is_symlink() and os.path.samefile(path, token))
    except (OSError, RuntimeError):
        return False


def surface_plan(vault):
    """Return (copies, problems). copies is a list of (rel, text or None)."""
    copies = []
    problems = []
    for path in iter_files(vault):
        if external_token_entry(path, vault):
            continue
        rel = path.relative_to(vault)
        text = None
        if path.suffix.lower() == ".md" and not path.is_symlink():
            text = path.read_text(errors="replace")
        if withheld(rel, text):
            continue
        if text is None:
            copies.append((rel, None))
            continue
        cleaned = redact(text)
        for kind in leaks(cleaned):
            problems.append(f"{rel.as_posix()}: {kind}")
        copies.append((rel, cleaned))
    return copies, problems


def write_tree(dest, vault, copies):
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True, mode=0o700)
    for rel, text in copies:
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        source = vault / rel
        if text is None:
            if source.is_symlink():
                target.symlink_to(os.readlink(source))
            else:
                shutil.copy2(source, target)
        else:
            target.write_text(text)
    note = dest / "SURFACE.md"
    note.write_text(
        "# Surface\n\n"
        "Generated copy of the vault with secrets removed. "
        "Personal, host-restore, and notes marked secret or employee are not here. "
        "This folder is not the working vault.\n"
    )


def publish_surface(cfg, copies):
    parent = cfg.surface.parent
    parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    staging = parent / (cfg.surface.name + ".tmp")
    assert_outside(staging, cfg.vault, "surface")
    write_tree(staging, cfg.vault, copies)
    if cfg.surface.exists() or cfg.surface.is_symlink():
        if cfg.surface.is_symlink():
            raise SystemExit("Refused to replace a symlinked surface")
        shutil.rmtree(cfg.surface)
    os.replace(staging, cfg.surface)
    os.chmod(cfg.surface, 0o700)


def fingerprint(root):
    found = {}
    for path in iter_files(root):
        if external_token_entry(path, root):
            continue
        rel = path.relative_to(root).as_posix()
        if path.is_symlink():
            found[rel] = ("link", os.readlink(path))
        else:
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
            found[rel] = ("file", digest)
    return found


def pack(vault, dest):
    excludes = ["--exclude=./" + path.relative_to(vault).as_posix()
                for path in iter_files(vault) if external_token_entry(path, vault)]
    tar = subprocess.Popen(
        ["tar", *excludes, "-cf", "-", "-C", str(vault), "."],
        stdout=subprocess.PIPE,
        env=env_for_tools(),
    )
    try:
        with dest.open("wb") as out:
            zstd = subprocess.Popen(
                ["zstd", "-q", "-c"],
                stdin=tar.stdout,
                stdout=out,
                env=env_for_tools(),
            )
            tar.stdout.close()
            zstd_code = zstd.wait()
        tar_code = tar.wait()
    except Exception:
        tar.kill()
        tar.wait()
        raise
    if tar_code != 0 or zstd_code != 0:
        raise BuildFailed("compress failed")


def unpack(archive, dest):
    dest.mkdir(parents=True, exist_ok=True)
    zstd = subprocess.Popen(
        ["zstd", "-d", "-q", "-c", str(archive)],
        stdout=subprocess.PIPE,
        env=env_for_tools(),
    )
    tar = subprocess.Popen(
        ["tar", "-xf", "-", "-C", str(dest)],
        stdin=zstd.stdout,
        env=env_for_tools(),
    )
    zstd.stdout.close()
    tar_code = tar.wait()
    zstd_code = zstd.wait()
    if tar_code != 0 or zstd_code != 0:
        raise BuildFailed("unpack failed")


def ensure_key(cfg, announce):
    cfg.key.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    created = not cfg.key.exists()
    if created:
        result = run_tool(["age-keygen", "-o", str(cfg.key)], capture_output=True, text=True)
        if result.returncode != 0:
            raise BuildFailed("could not create the key")
        os.chmod(cfg.key, 0o600)
        if announce:
            shown = RECIPIENT.search((result.stderr or "") + (result.stdout or ""))
            if shown:
                print(f"Recipient: {shown.group(0)}")
    else:
        os.chmod(cfg.key, 0o600)
    result = run_tool(["age-keygen", "-y", str(cfg.key)], capture_output=True, text=True)
    if result.returncode != 0:
        raise BuildFailed("could not read the public recipient")
    recipient = result.stdout.strip()
    if not RECIPIENT.fullmatch(recipient):
        raise BuildFailed("could not read the public recipient")
    return recipient


def encrypt(source, dest, recipient):
    result = run_tool(["age", "-r", recipient, "-o", str(dest), str(source)])
    if result.returncode != 0:
        raise BuildFailed("encrypt failed")


def decrypt(source, dest, key):
    result = run_tool(["age", "-d", "-i", str(key), "-o", str(dest), str(source)])
    if result.returncode != 0:
        raise BuildFailed("decrypt failed")


def verify(age_path, key, vault):
    with tempfile.TemporaryDirectory() as raw:
        work = Path(raw)
        archive = work / "vault.tzst"
        unpacked = work / "vault"
        decrypt(age_path, archive, key)
        unpack(archive, unpacked)
        if fingerprint(vault) != fingerprint(unpacked):
            raise BuildFailed("shadow does not match the vault")


def human_size(size):
    if size < 1024:
        return f"{size} B"
    if size < 1024 * 1024:
        return f"{size / 1024:.1f} KB"
    return f"{size / (1024 * 1024):.1f} MB"


def recent_notes(vault, limit=5):
    notes = []
    for path in iter_files(vault):
        if path.suffix.lower() == ".md" and not path.is_symlink():
            notes.append((path.stat().st_mtime, path.relative_to(vault).as_posix()))
    notes.sort(key=lambda item: (-item[0], item[1]))
    return [name for _, name in notes[:limit]]


def note_count(vault):
    return sum(
        1
        for path in iter_files(vault)
        if path.suffix.lower() == ".md" and not path.is_symlink()
    )


def description(when, vault, age_path):
    changed = recent_notes(vault)
    lines = [
        when.strftime("%Y-%m-%d %H:%M"),
        f"notes: {note_count(vault)}",
        f"size: {human_size(age_path.stat().st_size)}",
        "changed:",
    ]
    if changed:
        lines.extend(f"- {name}" for name in changed)
    else:
        lines.append("- none")
    return "\n".join(lines) + "\n"


def copy_stamp(path):
    match = STAMP.match(path.stem)
    if not match:
        return None
    return datetime.strptime(match.group(1), "%Y-%m-%d-%H%M")


def copies_of(folder):
    if not folder.is_dir():
        return []
    found = []
    for path in folder.glob("shadow-*.age"):
        stamp = copy_stamp(path)
        if stamp is not None:
            found.append((stamp, path))
    found.sort(key=lambda item: item[0])
    return found


def next_name(folder, when):
    base = "shadow-" + when.strftime("%Y-%m-%d-%H%M")
    name = base
    suffix = 2
    while (folder / f"{name}.age").exists() or (folder / f".{name}.partial").exists():
        name = f"{base}-{suffix}"
        suffix += 1
    return name


def write_shadow(cfg, when, recipient, fail=False):
    cfg.copies.mkdir(parents=True, mode=0o700, exist_ok=True)
    name = next_name(cfg.copies, when)
    partial = cfg.copies / f".{name}.partial"
    final = cfg.copies / f"{name}.age"
    try:
        with tempfile.TemporaryDirectory() as raw:
            archive = Path(raw) / "vault.tzst"
            pack(cfg.vault, archive)
            encrypt(archive, partial, recipient)
        verify(partial, cfg.key, cfg.vault)
        if fail:
            raise BuildFailed("injected")
        os.replace(partial, final)
        os.chmod(final, 0o600)
        text = cfg.copies / f"{name}.txt"
        text.write_text(description(when, cfg.vault, final))
        os.chmod(text, 0o600)
        return final
    except Exception:
        partial.unlink(missing_ok=True)
        raise


def prune(cfg, now):
    cutoff = now - timedelta(days=cfg.keep_days)
    for stamp, path in copies_of(cfg.copies):
        if stamp < cutoff:
            path.unlink(missing_ok=True)
            path.with_suffix(".txt").unlink(missing_ok=True)


def newest(cfg):
    found = copies_of(cfg.copies)
    if not found:
        return None
    return found[-1]


def build(cfg, now, fail=False, announce=True):
    guard_outputs(cfg)
    recipient = ensure_key(cfg, announce=announce)
    copies, problems = surface_plan(cfg.vault)
    age_path = write_shadow(cfg, now, recipient, fail=fail)
    if not problems:
        publish_surface(cfg, copies)
    prune(cfg, now)
    lines = []
    if problems:
        lines.extend(problems)
        lines.append(f"Surface withheld. Shadow: {age_path}")
    else:
        lines.append(f"Surface: {cfg.surface}. Shadow: {age_path}")
    return "\n".join(lines)


def due(cfg, now):
    guard_outputs(cfg)
    latest = newest(cfg)
    if latest is not None:
        age_days = (now - latest[0]).total_seconds() / 86400
        if age_days < cfg.every_days:
            return ""
    return build(cfg, now)


def open_shadow(cfg):
    guard_outputs(cfg)
    latest = newest(cfg)
    if latest is None:
        print("No shadow to open.")
        raise SystemExit(1)
    if cfg.open.is_symlink():
        raise SystemExit("Refused to replace a symlinked open folder")
    parent = cfg.open.parent
    parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    staging = parent / (cfg.open.name + ".tmp")
    assert_outside(staging, cfg.vault, "open folder")
    if staging.exists():
        shutil.rmtree(staging)
    try:
        with tempfile.TemporaryDirectory() as raw:
            archive = Path(raw) / "vault.tzst"
            decrypt(latest[1], archive, cfg.key)
            unpack(archive, staging)
        if cfg.open.exists():
            shutil.rmtree(cfg.open)
        os.replace(staging, cfg.open)
        os.chmod(cfg.open, 0o700)
    except Exception:
        if staging.exists():
            shutil.rmtree(staging, ignore_errors=True)
        raise
    return f"Shadow open: {cfg.open}"


def close_shadow(cfg):
    guard_outputs(cfg)
    if cfg.open.is_symlink():
        raise SystemExit("Refused to delete a symlink")
    if cfg.open.exists():
        shutil.rmtree(cfg.open)
    return "Shadow closed."


def list_shadows(cfg):
    found = copies_of(cfg.copies)
    if not found:
        return "Shadows: none."
    blocks = []
    for _stamp, path in reversed(found):
        text = path.with_suffix(".txt")
        if text.is_file():
            blocks.append(text.read_text().rstrip("\n"))
        else:
            blocks.append(path.name)
    return "\n\n".join(blocks)


def plist_text(script):
    log = Path.home() / ".local/share/brain/shadow-launchd.log"
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>brain-shadow</string>
  <key>ProgramArguments</key>
  <array>
    <string>{script}</string>
    <string>due</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{log}</string>
  <key>StandardErrorPath</key>
  <string>{log}</string>
</dict>
</plist>
"""


def install_agent():
    folder = Path.home() / "Library" / "LaunchAgents"
    folder.mkdir(parents=True, exist_ok=True)
    plist = folder / "brain-shadow.plist"
    script = str(Path(__file__).resolve())
    body = plist_text(script)
    if not plist.is_file() or plist.read_text() != body:
        plist.write_text(body)
    domain = f"gui/{os.getuid()}"
    subprocess.run(["launchctl", "bootout", f"{domain}/brain-shadow"], capture_output=True)
    loaded = subprocess.run(["launchctl", "bootstrap", domain, str(plist)], capture_output=True, text=True)
    if loaded.returncode != 0:
        print("LaunchAgent not loaded.")
    else:
        print(f"LaunchAgent: {plist}")


def execute(command, cfg, now, fail=False):
    if command in ("", "build"):
        return build(cfg, now, fail=fail)
    if command == "due":
        return due(cfg, now)
    if command == "open":
        return open_shadow(cfg)
    if command == "close":
        return close_shadow(cfg)
    if command == "list":
        return list_shadows(cfg)
    print(
        "fnsh shadow builds a copy.\n"
        "fnsh shadow open unpacks the newest copy.\n"
        "fnsh shadow close deletes that copy.\n"
        "fnsh shadow list prints the copies."
    )
    raise SystemExit(2)


def folder_size(root):
    total = 0
    for path in iter_files(root):
        if path.is_file() and not path.is_symlink():
            total += path.stat().st_size
    return total


def write_note(path, body):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(body)


def self_check():
    require_tools()
    now = datetime(2026, 10, 18, 18, 2)
    planted_email = "ada" + "@" + "example.com"
    planted_phone = "-".join(("555", "010", "1234"))
    with tempfile.TemporaryDirectory() as raw:
        root = Path(raw)
        vault = root / "vault"
        key_note = (
            "---\n"
            "tags: [project]\n"
            "---\n"
            "# Key\n"
            "api_key: sk-test-secret-value-123456\n"
            "-----BEGIN AGE TEST PRIVATE KEY-----\n"
            "not-a-real-key-just-a-block\n"
            "-----END AGE TEST PRIVATE KEY-----\n"
        )
        write_note(vault / "Work" / "key.md", key_note)
        write_note(
            vault / "Work" / "clean.md",
            "---\ntags: [project]\n---\n# Clean\nNothing private here.\n",
        )
        write_note(
            vault / "Work" / "bulk.md",
            "---\ntags: [project]\n---\n# Bulk\n" + ("note line\n" * 20000),
        )
        write_note(
            vault / "Personal" / "note.md",
            "---\ntags: [project]\n---\n# Personal\napi_key: " + "sk-" + "personal-secret-value-999\n",
        )
        write_note(
            vault / "Work" / "employee.md",
            "---\ntags: [employee]\n---\n# Employee\n" + planted_email + "\n",
        )
        write_note(
            vault / "Work" / "secret.md",
            "---\nsecret: true\ntags: [project]\n---\n# Secret\nkeep this out\n",
        )
        write_note(vault / "_Scripts" / "host-restore" / "claude" / "secret.md", "token: abcdefghijklmnop\n")
        managed = root / "ship-token"
        managed.write_text("fake-managed-token")
        original_token_path = ship_token.token_path
        ship_token.token_path = lambda: managed
        (vault / "Work" / "ship-token-link").symlink_to(managed)
        (vault / ".git").mkdir(parents=True)
        (vault / ".git" / "config").write_text("secret-in-git\n")
        (vault / ".obsidian").mkdir()
        (vault / ".obsidian" / "workspace.json").write_text('{"recent":"Personal/note.md"}\n')

        cfg = Config(
            vault=vault,
            surface=root / "surface",
            copies=root / "copies",
            open=root / "open",
            key=root / "shadow.key",
            install_agent=False,
        )
        reply = build(cfg, now, announce=False)
        if f"Surface: {cfg.surface}." not in reply or "Shadow:" not in reply:
            raise SystemExit(f"self-check: unexpected build reply: {reply}")
        surface_names = sorted(path.relative_to(cfg.surface).as_posix() for path in iter_files(cfg.surface))
        expected = {"SURFACE.md", "Work/bulk.md", "Work/clean.md", "Work/key.md"}
        if set(surface_names) != expected:
            raise SystemExit(f"self-check: surface files {surface_names}")
        if (cfg.surface / "Work" / "ship-token-link").exists():
            raise SystemExit("self-check: managed token link was surfaced")
        surfaced = (cfg.surface / "Work" / "key.md").read_text()
        if "sk-test-secret-value-123456" in surfaced or "PRIVATE KEY" in surfaced:
            raise SystemExit("self-check: surface still has a key")
        if "[withheld]" not in surfaced:
            raise SystemExit("self-check: key line was not withheld")
        if "Nothing private here." not in (cfg.surface / "Work" / "clean.md").read_text():
            raise SystemExit("self-check: clean note missing")

        opened = open_shadow(cfg)
        if opened != f"Shadow open: {cfg.open}":
            raise SystemExit(f"self-check: unexpected open reply: {opened}")
        if fingerprint(vault) != fingerprint(cfg.open):
            raise SystemExit("self-check: opened shadow does not match the vault")
        if (cfg.open / "Work" / "ship-token-link").exists():
            raise SystemExit("self-check: managed token link entered the shadow")
        if "sk-" + "personal-secret-value-999" not in (cfg.open / "Personal" / "note.md").read_text():
            raise SystemExit("self-check: opened shadow dropped the personal key")
        age_path = newest(cfg)[1]
        if age_path.stat().st_size >= folder_size(vault):
            raise SystemExit("self-check: shadow file is not smaller than the vault")
        if close_shadow(cfg) != "Shadow closed." or cfg.open.exists():
            raise SystemExit("self-check: close left the open folder")

        listed = list_shadows(cfg)
        if "notes:" not in listed or "changed:" not in listed:
            raise SystemExit("self-check: list missing the description")

        # A copy younger than 30 days: the scheduled run builds nothing.
        before = list(cfg.copies.glob("shadow-*.age"))
        if due(cfg, now + timedelta(days=10)) != "":
            raise SystemExit("self-check: young copy still built")
        if list(cfg.copies.glob("shadow-*.age")) != before:
            raise SystemExit("self-check: young copy changed the copies")

        # Newest is 31 days old, oldest is 91: build one, then delete only the oldest.
        for path in cfg.copies.glob("shadow-*"):
            path.unlink()
        old = now - timedelta(days=91)
        mid = now - timedelta(days=31)
        for stamp in (old, mid):
            name = "shadow-" + stamp.strftime("%Y-%m-%d-%H%M")
            (cfg.copies / f"{name}.age").write_bytes(b"old")
            (cfg.copies / f"{name}.txt").write_text("old\n")
        due_reply = due(cfg, now)
        if "Shadow:" not in due_reply:
            raise SystemExit(f"self-check: 31-day run did not build: {due_reply}")
        names = sorted(path.name for path in cfg.copies.glob("shadow-*.age"))
        if any(name.startswith("shadow-" + old.strftime("%Y-%m-%d-%H%M")) for name in names):
            raise SystemExit("self-check: 91-day copy was kept")
        if not any(name.startswith("shadow-" + mid.strftime("%Y-%m-%d-%H%M")) for name in names):
            raise SystemExit("self-check: 31-day copy was deleted")
        fresh = [name for name in names if name.startswith("shadow-" + now.strftime("%Y-%m-%d-%H%M"))]
        if len(fresh) != 1:
            raise SystemExit(f"self-check: expected one new copy, got {names}")

        # A failed build deletes nothing.
        kept = sorted(path.name for path in cfg.copies.glob("shadow-*"))
        try:
            build(cfg, now + timedelta(minutes=5), fail=True)
        except BuildFailed:
            pass
        else:
            raise SystemExit("self-check: injected failure did not fail")
        if sorted(path.name for path in cfg.copies.glob("shadow-*")) != kept:
            raise SystemExit("self-check: failed build deleted a copy")

        # An email in a kept note writes no surface and still keeps the new shadow.
        surface_before = (cfg.surface / "Work" / "clean.md").read_text()
        write_note(
            vault / "Work" / "contact.md",
            "---\ntags: [project]\n---\n# Contact\n" + planted_email + "\n" + planted_phone + "\n",
        )
        blocked = build(cfg, now + timedelta(minutes=10), announce=False)
        if "Work/contact.md: email" not in blocked or "Work/contact.md: phone" not in blocked:
            raise SystemExit(f"self-check: email was not reported: {blocked}")
        if "Surface withheld." not in blocked:
            raise SystemExit("self-check: surface was not withheld")
        if (cfg.surface / "Work" / "clean.md").read_text() != surface_before:
            raise SystemExit("self-check: withheld surface was replaced")
        if not (cfg.surface / "Work" / "contact.md").exists() and planted_email not in surface_before:
            pass
        if (cfg.surface / "Work" / "contact.md").exists():
            raise SystemExit("self-check: email note was copied to the surface")

        try:
            bad = Config(
                vault=vault,
                surface=vault / "surface",
                copies=cfg.copies,
                open=cfg.open,
                key=cfg.key,
                install_agent=False,
            )
            build(bad, now)
        except SystemExit as error:
            if "Refused to write inside the vault" not in str(error):
                raise
        else:
            raise SystemExit("self-check: write inside the vault was allowed")
        ship_token.token_path = original_token_path
    print("self-check ok")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "self-check":
        self_check()
        return
    require_tools()
    cfg = load_config()
    if cfg.install_agent:
        install_agent()
    command = sys.argv[1] if len(sys.argv) > 1 else "build"
    try:
        reply = execute(command, cfg, datetime.now())
    except BuildFailed as error:
        print(f"Shadow failed: {error}")
        raise SystemExit(1)
    if reply:
        print(reply)


if __name__ == "__main__":
    main()
