    def test_global_local_concurrent_delivery(self):
        legacy, settings = self.global_hook(self.root / "_Scripts/file-session")
        before = settings.read_bytes()
        self.assertIn("Duplicate delivery protected", self.run_setup("claude"))
        self.assertEqual(settings.read_bytes(), before)
        current = self.root / ".claude/hooks/notedbro.py"
        payload = self.transcript('quoted-session')
        processes = [subprocess.Popen([sys.executable, str(p)], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=self.env) for p in (legacy, current)]
        for process in processes:
            process.stdin.write(payload)
            process.stdin.close()
            process.stdin = None
        for process in processes:
            out, err = process.communicate(timeout=30)
            self.assertEqual(process.returncode, 0, out + err)
        for hook in (legacy, current):
            replay = subprocess.run([sys.executable, str(hook)], input=payload, env=self.env, capture_output=True, text=True)
            self.assertEqual(replay.returncode, 0, replay.stderr)
        notes = list((self.root / "Personal/Chats/Sessions").glob("*.md"))
        self.assertEqual(len(notes), 1)
        self.assertEqual(notes[0].read_text().count('conversation: quoted-session'), 1)
        index = (self.root / "Personal/Chats/Chats sessions.md").read_text()
        self.assertEqual(index.count("[[" + notes[0].stem + "]]"), 1)
        daily = list((self.root / "Personal/Daily").glob("*.md"))
        self.assertEqual(len(daily), 1)
        self.assertEqual(daily[0].read_text().count('quoted-session'), 1)

    def test_failure_releases_lock_and_repair(self):
        self.run_setup("claude")
        mod = module(self.root / "_Scripts/file-session")
        mod.VAULT = str(self.root)
        args = mod.parse_args(["--host", "codex", "--conversation", "retry-case", "--manual"])
        old = mod.ensure_index
        def fail(*_):
            raise RuntimeError("injected index failure")
        mod.ensure_index = fail
        with patch.dict(os.environ, self.env):
            with self.assertRaises(RuntimeError):
                mod.file_session(args)
            mod.ensure_index = old
            self.assertEqual(mod.file_session(args), 0)
        self.assertEqual(len(list((self.root / "Personal/Chats/Sessions").glob("*.md"))), 1)
        self.assertTrue((self.root / "Personal/Chats/Chats sessions.md").is_file())

