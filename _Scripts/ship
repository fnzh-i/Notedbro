def main(argv):
    if argv and argv[0] == "self-check":
        self_check()
        return 0
    # A quiet guard registration. Failures here must not block the refusal messages.
    try:
        import importlib.machinery
        import importlib.util
        path = Path(__file__).resolve().with_name("guard")
        loader = importlib.machinery.SourceFileLoader("guard_script", str(path))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        module.run(vault_root(), verbose=False)
    except Exception:
        pass
    print(resolve(argv, vault_root()))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
