        utf8_probe = root / "utf8-probe"
        write(utf8_probe, "├─ UTF-8 output\n")
        if utf8_probe.read_bytes() != "├─ UTF-8 output\n".encode("utf-8"):
            raise SystemExit("self-check: publish writes were not UTF-8")

        source = Path(__file__).resolve().parent.parent
        files, _missing = included(source)
        for rel in files:
            write(vault / rel, "")
            shutil.copy2(source / rel, vault / rel)
        write(vault / "_Scripts" / "host-restore" / "claude" / "CLAUDE.md", "keep out\n")
        diary = "Di" + "ary"
        write(vault / "Personal" / f"{diary}.md", "---\ntags: [personal]\n---\n# Private\n")
        fake_pat = "github" + "_pat_" + "abcdefghij"
        write(vault / "Personal" / "ship-token-example.md", "token: " + fake_pat + "\n")
        if not any("GitHub token" in hit and fake_pat not in hit for hit in publish_scan.vault_token_hits(vault)):
            raise SystemExit("self-check: fine-grained token scanner missed a private file")
        external = root / "fake-managed-token"
        external.write_text(fake_pat, encoding="utf-8")
        try:
            (vault / "_Scripts" / "managed-token-link").symlink_to(external)
        except OSError:
            if os.name != "nt":
                raise
        write(vault / "Index.md", "---\ntags: [meta]\n---\n# Live index\n")

        bare = root / "bare-out"
        reply, ok = publish(vault, bare, denylist)
        if ok or publish_scan.MAINTAINER_MESSAGE not in reply or bare.exists():
            raise SystemExit(f"self-check: missing maintainer setup did not refuse cleanly:\n{reply}")
        write(vault / "Workspace map.md", (
            "## Maintainer\n- maintainer: yes\n\n## Ship\n"
            "| Project | Rule | Folder | Base |\n|---|---|---|---|\n"
            f"| Example kit | notedbro | {out} | main |\n"
        ))
        if not shutil.which("git"):
            raise SystemExit("self-check: git is required for public-owned preservation")
        subprocess.run(["git", "init", "-q", str(out)], check=True)
        test_email = "tests" + "@" + "example.invalid"
        subprocess.run(["git", "-C", str(out), "config", "user.email", test_email], check=True)
        subprocess.run(["git", "-C", str(out), "config", "user.name", "Publish tests"], check=True)
        for rel in PUBLIC_OWNED:
            target = out / rel
            if (vault / rel).is_file():
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(vault / rel, target)
            else:
                write(target, "public fixture\n")
        write(out / ".gitignore", gitignore_text(vault))
        subprocess.run(["git", "-C", str(out), "add", "-f", "."], check=True)
        subprocess.run(["git", "-C", str(out), "commit", "-qm", "public source"], check=True)
        subprocess.run(["git", "-C", str(out), "branch", "-M", "main"], check=True)
        subprocess.run(["git", "-C", str(out), "update-ref", "refs/remotes/origin/main", "HEAD"], check=True)

        reply, ok = publish(vault, out, denylist)
        if not ok or reply != f"Published: {shown(out)}":
            raise SystemExit(f"self-check: clean publish failed:\n{reply}")
        prefix_file = out / "Prefixes.md"
        original_prefixes = prefix_file.read_bytes()
        try:
            prefix_file.write_bytes(original_prefixes + b"\n")
            if not any("stale bootstrap" in problem for problem in check_tree(out)):
                raise SystemExit("self-check: stale bootstrap source was not detected")
        finally:
            prefix_file.write_bytes(original_prefixes)
        names = {path.relative_to(out).as_posix() for path in iter_files(out)}
        for rel in names:
            if rel.endswith("managed-token-link") or rel.endswith("ship-token-example.md"):
                raise SystemExit("self-check: managed token material was published")
            if rel.startswith("_Scripts/host-restore/"):
                raise SystemExit(f"self-check: {rel} was published")
            if rel.startswith("Personal/") and rel not in ("Personal/Personal.md", "Personal/Chats/Chats.md"):
                raise SystemExit(f"self-check: {rel} was published")
        for rel in ("Work/Example/Example.md", "Collaboration/Collaboration.md",
                    "Hackathons/Hackathons.md", "Research/Research.md",
                    "Personal/Personal.md", "Personal/Chats/Chats.md",
                    "Workspace map.example.md", ".gitignore", "_Config/bootstrap.md"):
            if rel not in names:
                raise SystemExit(f"self-check: {rel} was not generated")
        if "Live index" in (out / "Index.md").read_text(encoding="utf-8"):
            raise SystemExit("self-check: live Index was copied")
        for rel in ("Preferences.md", "Parameters.md"):
            if (out / rel).read_bytes() != (vault / rel).read_bytes():
                raise SystemExit(f"self-check: {rel} was not copied intact")

        if shutil.which("git"):
            for rel in ("Personal/Diary.md", "Work/Acme/Acme.md", "Work/Example/my-note.md", "School/note.md",
                        "Research/Topic/Topic.md", "Workspace map.md",
                        "Plans/plan.md", "Skill files/x.md", "_Scripts/host-restore/x", "a.canvas", "shadow.key"):
                if not ignored(out, rel):
                    raise SystemExit(f"self-check: {rel} is not ignored")
            for rel in ("Work/Example/Example.md", "Research/Research.md", "Personal/Personal.md",
                        "Personal/Chats/Chats.md", "Workspace map.example.md", "README.md",
                        "_Scripts/publish"):
                if ignored(out, rel):
                    raise SystemExit(f"self-check: {rel} is ignored")

        before = (out / "Index.md").read_text(encoding="utf-8")
        (out / "marker").write_text("previous\n", encoding="utf-8")
        for rel, text, kind in (
            ("Prefixes.md", planted_email, "email ("),
            ("Terms.md", planted_project.lower(), f"denylist ({planted_project})"),
            ("Parameters.md", "see " + "ZQ" + "-12", "denylist (" + "ZQ" + "-)"),
            ("Parameters.md", "the " + PRODUCT + " kit", f"{PRODUCT} outside the title"),
            ("Parameters.md", str(Path.home()) + "/x", "home folder"),
        ):
            original = (vault / rel).read_text(encoding="utf-8")
            (vault / rel).write_text(original + text + "\n", encoding="utf-8")
            reply, ok = publish(vault, out, denylist)
            (vault / rel).write_text(original, encoding="utf-8")
            if ok or kind not in reply or not reply.endswith("Publish withheld."):
                raise SystemExit(f"self-check: {kind} was not withheld:\n{reply}")
            if not (out / "marker").is_file() or (out / "Index.md").read_text(encoding="utf-8") != before:
                raise SystemExit("self-check: a withheld publish changed the previous folder")

        for word in ("de" + "cision", "month" + "s-1", "zq" + "-1"):
            if scan_text_hits(word, ["ci" + "si", "ZQ" + "-"]):
                raise SystemExit(f"self-check: {word!r} matched a term inside a word")
        if not scan_text_hits("fnsh " + "ci" + "si params", ["ci" + "si"]):
            raise SystemExit("self-check: a standalone term was missed")
        scanner_root = root / "scanner"
        workflow = scanner_root / ".github" / "workflows" / "ci.yml"
        write(workflow, "if: runner.os == 'Windows'\n")
        with patch.object(publish_scan.getpass, "getuser", return_value="runner"):
            if publish_scan.scan(scanner_root, []):
                raise SystemExit("self-check: runner.os was treated as a login name")
        write(workflow, "owner: runner\n")
        with patch.object(publish_scan.getpass, "getuser", return_value="runner"):
            if not any("login name" in hit for hit in publish_scan.scan(scanner_root, [])):
                raise SystemExit("self-check: a workflow login name was not detected")
        if publish_scan.scan_text(publish_scan.PUBLIC_SLUG, ["fn" + "zh"]):
            raise SystemExit("self-check: the public repository identifier was withheld")
        if not publish_scan.scan_text("fn" + "zh-i/Other", ["fn" + "zh"]):
            raise SystemExit("self-check: the public identifier exception was too broad")
        if publish_scan.scan_text(publish_scan.PUBLIC_SLUG + ".", ["fn" + "zh"]):
            raise SystemExit("self-check: trailing punctuation broke the public identifier exception")
        if not publish_scan.scan_text(publish_scan.PUBLIC_SLUG + ".com", ["fn" + "zh"]):
            raise SystemExit("self-check: a suffixed public identifier was allowed")

        noise = vault / "assets" / "branding" / "noise.png"
        noise.parent.mkdir(parents=True, exist_ok=True)
        noise.write_bytes(b"\x89PNG\r\n\x1a\n" + planted_project.encode("ascii"))
        reply, ok = publish(vault, out, denylist)
        if not ok or reply != f"Published: {shown(out)}":
            raise SystemExit(f"self-check: an image with denylist bytes was withheld:\n{reply}")
        if not (out / "assets" / "branding" / "noise.png").is_file():
            raise SystemExit("self-check: the image was not published")
        noise.unlink()

        write(vault / "Personal" / "Personal.md", "---\ntags: [area]\n---\n# My real hub\n")
        reply, ok = publish(vault, out, denylist)
        if not ok or not (out / ".git").is_dir():
            raise SystemExit(f"self-check: republish lost .git:\n{reply}")
        if "My real hub" in (out / "Personal" / "Personal.md").read_text(encoding="utf-8"):
            raise SystemExit("self-check: live Personal.md was copied")
        if not (out / "Personal" / "Chats" / "Chats.md").is_file():
            raise SystemExit("self-check: starter Chats.md was missing")
        sample = root / "sample-deny"
        sample.write_text("SAMPLE-EMPLOYER\nSAMPLE-CLIENT\nSAMPLE-NAME\n", encoding="utf-8")
        reply, ok = publish(vault, root / "sample-out", sample)
        if ok or "sample words" not in reply or (root / "sample-out").exists():
            raise SystemExit(f"self-check: a sample denylist was not refused:\n{reply}")
        token = "gh" + "p_" + "abcdefghij"
        if not any("****" in hit for hit in publish_scan.scan_text("token " + token, [])):
            raise SystemExit("self-check: a token was not masked")

        try:
            publish(vault, vault / "publish", denylist)
        except SystemExit as error:
            if "Refused to write inside the vault" not in str(error):
                raise
        else:
            raise SystemExit("self-check: write inside the vault was allowed")
    print("self-check ok")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "self-check":
        self_check()
        return
    reply, ok = publish()
    print(reply)
    raise SystemExit(0 if ok else 1)


if __name__ == "__main__":
    main()
