#!/usr/bin/env python3
"""Write _Config/bootstrap.md from the vault rules, prefixes, and parameters."""

import hashlib
import os
import sys
from pathlib import Path


sys.path.insert(0, str(Path(__file__).resolve().parent))
from vault_path import vault_root  # noqa: E402

VAULT = vault_root()
SOURCES = (
    "How this vault works.md",
    "Prefixes.md",
    "Parameters.md",
)


def source_bytes(vault=VAULT):
    """Canonical LF bytes of the three text sources, with nothing between them."""
    return b"".join((vault / name).read_bytes().replace(b"\r\n", b"\n") for name in SOURCES)


def source_digest(vault=VAULT):
    return hashlib.sha256(source_bytes(vault)).hexdigest()


def render(vault=VAULT):
    digest = source_digest(vault)
    lines = [
        "---",
        "tags: [meta]",
        "generated: true",
        "---",
        "# Bootstrap",
        "",
        "Generated by `_Scripts/build-bootstrap`. Do not edit by hand. Edit How this vault works, Prefixes, and Parameters, then run the script again.",
        "",
        "Sources: How this vault works.md, Prefixes.md, Parameters.md",
        "",
        f"sources-sha256: {digest}",
        "",
    ]
    for name in SOURCES:
        lines.append(f"## Source: {name}")
        lines.append("")
        lines.append((vault / name).read_text(encoding="utf-8").rstrip("\n"))
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def main():
    out = VAULT / "_Config" / "bootstrap.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(render().encode("utf-8"))
    print(f"Wrote {out.relative_to(VAULT)}")


if __name__ == "__main__":
    main()
