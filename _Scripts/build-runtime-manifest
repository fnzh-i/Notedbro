#!/usr/bin/env python3
"""Generate the current release's runtime checksums from the starter include list."""
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
import migration

root = Path(__file__).resolve().parent.parent
lines = ["# Notedbro 1.1.0 runtime checksums. Regenerate after changing shipped runtime files."]
for rel, path in sorted(migration.release_files(root).items()):
    if rel.startswith("_Scripts/") and path.suffix != ".sha256":
        lines.append(migration.sha(path) + "  " + rel)
output = root / "_Scripts/release-runtime.sha256"
data = "\n".join(lines) + "\n"
if len(sys.argv) == 2 and sys.argv[1] == "--check":
    if not output.exists() or output.read_bytes() != data.encode("utf-8"):
        raise SystemExit("Runtime checksum manifest is stale; run python3 _Scripts/build-runtime-manifest.")
elif len(sys.argv) == 1:
    if not output.exists() or output.read_bytes() != data.encode("utf-8"):
        output.write_bytes(data.encode("utf-8"))
else:
    raise SystemExit("Usage: build-runtime-manifest [--check]")
print(f"Runtime checksums: {len(lines) - 1} files")
