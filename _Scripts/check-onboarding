#!/usr/bin/env python3
"""Exercise public setup and migration in disposable exported installations."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

SOURCE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SOURCE / "_Scripts"))
import migration
import onboarding


def module(path):
    loader = importlib.machinery.SourceFileLoader("fixture_" + path.name.replace("-", "_"), str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


class Onboarding(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.base = Path(self.tmp.name).resolve()
        self.root = self.base / "Brain with spaces"
        def ignored(directory, names):
            found = shutil.ignore_patterns(".git", "__pycache__", ".claude", ".notedbro-local", "*.canvas", "host-restore", "report.md")(directory, names)
            if Path(directory) == SOURCE:
                found.add("Workspace map.md")
            return found
        shutil.copytree(SOURCE, self.root, ignore=ignored)
        self.home = self.base / "test home"
        self.home.mkdir()
        self.env = dict(os.environ, BRAIN_VAULT=str(self.root), BRAIN_HOME=str(self.home))
        self.env.pop("CLAUDE_CONFIG_DIR", None)

    def run_setup(self, host, expected=0):
        p = subprocess.run([sys.executable, str(self.root / "_Scripts/setup"), host, "home", str(self.home)], env=self.env, capture_output=True, text=True)
        self.assertEqual(p.returncode, expected, p.stdout + p.stderr)
        return p.stdout

    def state(self):
        return {str(p): (p.read_bytes(), p.stat().st_mtime_ns) for top in (self.root, self.home) for p in top.rglob("*") if p.is_file() and "__pycache__" not in p.parts}

    def test_hosts_and_repeat(self):
        for host in ("claude", "cursor", "codex", "web"):
            with self.subTest(host=host):
                output = self.run_setup(host)
                if host == "web":
                    self.assertIn("No browser connection or automatic filing was configured.", output)
                    self.assertNotIn("Configuration installed", output)
                before = self.state()
                self.run_setup(host)
                self.assertEqual(before, self.state())
        parsed = module(self.root / "_Scripts/workspace_map.py").load_map(self.root)
        self.assertFalse(parsed["company"])
        self.assertFalse(parsed["ticket_key"])
        self.assertFalse(parsed["ships"])
        self.assertFalse(parsed["maintainer"])
        self.assertEqual(json.loads((self.root / "Decisions and sessions.canvas").read_text()), {"nodes": [], "edges": []})
        self.assertFalse((self.home / ".claude/settings.json").exists())
        self.assertFalse((self.home / ".claude/CLAUDE.md").exists())

    def test_preserve_and_repair(self):
        local = self.root / ".claude/settings.local.json"
        local.parent.mkdir()
        obj = {"permissions": {"deny": ["Bash(example)"]}, "hooks": {"SessionEnd": [{"hooks": [{"type": "command", "command": "echo other"}]}]}}
        local.write_text(json.dumps(obj))
        shared = local.with_name("settings.json")
        shared.write_text('{"model":"example"}\n')
        old = self.home / ".codex/AGENTS.md"
        old.parent.mkdir()
        old.write_text("Custom start\n<!-- brain:start -->\nRead Templates/Session.md and Scripts/file-session.\n<!-- brain:end -->\nCustom end\n")
        custom = self.root / "Workspace map.md"
        custom.write_text("---\ntags: [meta]\n---\n# Custom map\n")
        self.run_setup("codex")
        self.run_setup("claude")
        after = json.loads(local.read_text())
        self.assertEqual(after["permissions"], obj["permissions"])
        self.assertEqual(len(after["hooks"]["SessionEnd"]), 2)
        self.assertEqual(shared.read_text(), '{"model":"example"}\n')
        self.assertEqual(custom.read_text(), "---\ntags: [meta]\n---\n# Custom map\n")
        self.assertIn("_Templates/Session.md", old.read_text())
        self.assertIn("Custom end", old.read_text())
        self.assertTrue(list((self.root / ".notedbro-local/backups").rglob("AGENTS.md")))

