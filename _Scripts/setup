#!/usr/bin/env python3
"""Prepare local files and one host. No network access or global Claude writes."""
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
import onboarding as ob
import migration
from vault_path import vault_root


def load(name):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(Path(__file__).with_name(name)))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main(argv):
    if len(argv) not in (1, 3) or argv[0] not in ("cursor", "claude", "codex", "web") or len(argv) == 3 and argv[1] != "home":
        print("Usage: python3 _Scripts/setup <cursor|claude|codex|web> [home PATH]")
        return 2
    root = vault_root().resolve()
    home = Path(argv[2]).expanduser().resolve() if len(argv) == 3 else Path(os.environ.get("BRAIN_HOME", str(Path.home()))).resolve()
    host = argv[0]
    events, issues = [], []
    try:
        issues.extend(migration.runtime_problems(root))
        if issues:
            print("\n".join(issues))
            print("Setup incomplete: finish script migration before configuring hooks or promoting the version.")
            return 1
        ob.ignore_rules(root, events)
        if not (root / "Workspace map.md").exists():
            ob.write(root, root / "Workspace map.md", ob.MINIMAL_MAP, events, private=True)
        if (root / "Workspace map.md").is_symlink():
            raise ValueError("Workspace map.md is a symlink; review it manually")
        issues.extend(ob.map_readiness(root))
        for rel in ("Hosts/Web.md", "Hosts/Cursor.md", "Hosts/Claude.md"):
            path = root / rel
            ob.write(root, path, ob.corrected(path.read_text()), events)
        # Only marked blocks are changed in existing user instruction files.
        repair_paths = [home / ".codex/AGENTS.md"] if host == "codex" else [home / ".claude/CLAUDE.md"] if host == "claude" else []
        for path in repair_paths:
            if path.is_file() and ob.START in path.read_text():
                ob.install_instructions(root, path, events)
        if host == "claude":
            ob.install_claude(root, events)
        elif host == "codex":
            ob.install_instructions(root, home / ".codex/AGENTS.md", events)
        elif host == "cursor":
            module = load("load-host")
            restored, reported, left, copied, paste = module.restore_host("cursor", home)
            events.extend(restored)
            issues.extend(reported)
        legacy, protected = ob.legacy_hooks(root, home)
        issues.extend(legacy)
        events.extend(protected)
        # Refresh derived rules if a known source path was repaired.
        bootstrap = load("build-bootstrap")
        ob.write(root, root / "_Config/bootstrap.md", bootstrap.render(root), events)
        views = load("build-views")
        canvas, _, _ = views.build(views.collect())
        import json
        ob.write(root, root / views.CANVAS, json.dumps(canvas, indent=2, ensure_ascii=False) + "\n", events, private=True)
        check = load("check-vault")
        issues.extend(check.check())
        if not issues:
            ob.write(root, root / "_Scripts/notedbro-version", "1.1.0\n", events)
        print("\n".join(events) if events else "Local files unchanged.")
        if issues:
            print("\n".join(issues))
            print("Setup incomplete. Resolve the items above and rerun; the installed version was not advanced.")
            return 1
        if host == "web":
            print("Local files prepared. Web workflow is manual.\nNo browser connection or automatic filing was configured.")
            print("Paste relevant instructions and context into the web chat; save its returned session note under Personal/Chats/Sessions.")
        elif host == "claude":
            print(f"Configuration installed. Start Claude at Brain's root: cd {str(root)!r}, then claude. Verify one session after exiting Claude.")
        elif host == "cursor":
            print("Pending manual action: Cursor Settings > Rules > User Rules: paste the marked block from Hosts/Web.md, using this installation's full path. Start a new chat and verify one saved session.")
        else:
            print("Instructions installed. Start a new Codex chat with access to this folder. Send fnsh brain, then fnsh update after a change; verify the saved session. Filing is manual.")
        print("First real session verification is still required. See How to set up.md.")
        return 0
    except (ValueError, OSError, KeyError, AttributeError, TypeError) as error:
        print("\n".join(events))
        print(f"Setup incomplete: {error}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
