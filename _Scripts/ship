def denylist_path():
    return Path(os.path.expanduser(os.environ.get("BRAIN_PUBLISH_DENYLIST", "~/.config/brain/publish-denylist")))


def git(repo, *args, check=True):
    result = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, env=child_env())
    if check and result.returncode != 0:
        raise RuntimeError(safe_error(result.stderr.strip()) or "git " + " ".join(args))
    return result


def branch_name(title):
    words = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-").split("-")
    words = [word for word in words if word][:4] or ["update"]
    name = "docs/" + "-".join(words)
    if name in {"main", "master"} or name.startswith("main/"):
        name = "docs/update"
    return name


def diff_names(repo, base):
    diff = git(repo, "diff", "--name-only", base, check=False).stdout.splitlines()
    others = git(repo, "ls-files", "--others", "--exclude-standard", check=False).stdout.splitlines()
    return sorted({line.strip() for line in diff + others if line.strip() and line.strip() != "report.md"})


def content_path(repo, name):
    rel = Path(name)
    if rel.is_absolute() or ".." in rel.parts or not rel.parts:
        raise RuntimeError("Ship selected an unsafe file path.")
    current = Path(repo)
    for part in rel.parts:
        current = current / part
        if current.is_symlink():
            raise RuntimeError("Ship will not read or commit a symlinked file.")
    return current


def file_hash(repo, names):
    digest = hashlib.sha256()
    for name in names:
        digest.update(name.encode())
        path = content_path(repo, name)
        if path.is_file():
            digest.update(path.read_bytes())
    return digest.hexdigest()


def project_rule(vault, project):
    found = workspace_map.load_map(vault)
    ships = found.get("ships", [])
    if project:
        key = project.lower()
        for name, rule, folder, base, repository in ships:
            if name.lower() == key or workspace_map.expand(name).lower() == key:
                return name, rule, folder, base, repository, found
        return None
    return None


def grouped(unknown, private, scans):
    lines = []
    folders = {}
    loose = []
    for rel in unknown:
        top, _, rest = rel.partition("/")
        if rest:
            folders.setdefault(top + "/", []).append(rel)
        else:
            loose.append(rel)
    if unknown or private:
        count_folders = len(folders)
        count_files = len(loose) + len(private)
        lines.append(f"Ship blocked: {count_folders} folders and {count_files} files are not part of the starter kit.")
        lines.append("Unknown folders and files are treated as private.")
        lines.append("")
        for folder, paths in sorted(folders.items()):
            lines.append(f"  {folder:<14} ({len(paths)} files)")
        shown = private + loose
        extra = shown[10:]
        for rel in shown[:10]:
            lines.append(f"  {rel}")
        if extra:
            lines.append(f"  and {len(extra)} more")
        lines.append("")
        lines.append("To ship a project folder on purpose, add a row for it to ## Ship in Workspace map.md.")
        lines.append("Run fnsh guard to keep these out of git.")
    if scans:
        lines.append("Content scan:")
        for rel, hits in scans:
            shown = hits[:10]
            lines.append(f"  {rel}: " + ", ".join(shown))
            if len(hits) > 10:
                lines.append(f"    and {len(hits) - 10} more")
    lines.append(LOCAL_LINE)
    return "\n".join(lines)


def classify(vault, repo, names, project_folder):
    files, dirs = publish_scan.read_manifest(repo)
    if not files and not dirs:
        files, dirs = publish_scan.read_manifest(vault)
    unknown, private = [], []
    root = Path(project_folder).resolve() if project_folder else None
    repo_root = Path(repo).resolve()
    for rel in names:
        content_path(repo, rel)
        if publish_scan.is_private_path(rel) and not publish_scan.in_manifest(rel, files, dirs):
            private.append(rel)
            continue
        if publish_scan.in_manifest(rel, files, dirs):
            continue
        inside = False
        if root and root != repo_root:
            try:
                (repo_root / rel).resolve().relative_to(root)
                inside = True
            except ValueError:
                inside = False
        if inside:
            continue
        unknown.append(rel)
    scans = []
    terms = publish_scan.read_terms(denylist_path()) if denylist_path().is_file() else []
    for rel in names:
        path = content_path(repo, rel)
        if not path.is_file() or path.suffix.lower() in publish_scan.IMAGE_SUFFIXES:
            continue
        hits = publish_scan.scan_text(path.read_text(errors="replace"), terms)
        if hits:
            scans.append((rel, hits))
    return unknown, private, scans


def report_hash(repo):
    path = Path(repo) / "report.md"
    if not path.is_file():
        return "missing"
    return hashlib.sha256(path.read_bytes()).hexdigest()


def report_from(repo, project, base):
    path = Path(repo) / "report.md"
    if path.is_symlink():
        return None, None, "report.md cannot be a symlink."
    if not path.is_file():
        names = diff_names(repo, base)
        if not names:
            return None, None, "nothing to ship."
        title = re.sub(r"\s+", " ", f"Update {project}").strip()[:80]
        body = "\n".join([
            "## Change and reason",
            f"Ship the current {project} changes; report.md was not available.",
            "",
            "## Files touched",
            *[f"- {name}" for name in names],
            "",
            "## Files not touched",
            "Not specified; this description was generated from the changed files.",
        ])
        return title, body + "\n", None
    text = path.read_text(errors="replace").strip()
    sections = {}
    current = None
    for line in text.splitlines():
        heading = re.match(r"^##\s+(.+?)\s*$", line)
        if heading:
            current = re.sub(r"[^a-z]+", " ", heading.group(1).lower()).strip()
            sections[current] = []
        elif current:
            sections[current].append(line)
    required = ("change and reason", "files touched", "files not touched")
    missing = [name for name in required if not " ".join(sections.get(name, [])).strip()]
    if missing:
        return None, None, "report.md is incomplete; add non-empty sections: " + ", ".join(missing) + "."
    change = next(line.strip().lstrip("- *") for line in sections["change and reason"] if line.strip())
    title = re.sub(r"\s+", " ", change).split(". ", 1)[0].rstrip(".")[:80]
    if not title:
        return None, None, "report.md has no usable summary under Change and reason."
    lines = text.splitlines()
    body = "\n".join(lines[1:]).strip() if lines and lines[0].startswith("# ") else text
    if not body:
        return None, None, "report.md has no body for the commit description and PR body."
    return title, body + "\n", None


def shutil_which(name):
    return shutil.which(name)


def gh_bin():
    return shutil_which("gh") or "gh"


def gh_command():
    return [sys.executable, str(SELF_CHECK_GH)] if SELF_CHECK_GH else [gh_bin()]


def github_repo(repo, expected=None):
    """Resolve origin, rejecting credential-bearing and non-GitHub remotes."""
    raw = git(repo, "config", "--get-all", "remote.origin.url", check=False)
    expanded = git(repo, "remote", "get-url", "--all", "origin", check=False)
    push_raw = git(repo, "config", "--get-all", "remote.origin.pushurl", check=False)
    push_expanded = git(repo, "remote", "get-url", "--push", "--all", "origin", check=False)
    if raw.returncode or expanded.returncode or push_expanded.returncode:
        raise RuntimeError("origin remote is missing.")
    fetch_urls = expanded.stdout.splitlines()
    push_urls = push_expanded.stdout.splitlines()
    if len(fetch_urls) != 1 or len(push_urls) != 1:
        raise RuntimeError("origin must have exactly one fetch URL and one push URL.")
    urls = raw.stdout.splitlines() + fetch_urls + push_urls
    if push_raw.returncode == 0:
        urls += push_raw.stdout.splitlines()
    for url in urls:
        if any(secret and secret in url for secret in (os.environ.get(key) for key in SECRET_ENV)):
            raise RuntimeError("origin remote contains a credential; remove it from Git configuration.")
        if re.search(r"(?i)https?://[^/@\s]+@", url):
            raise RuntimeError("origin remote contains a credential; remove it from Git configuration.")

    def parse(url):
        match = re.fullmatch(r"git@github\.com:([^/]+)/([^/]+?)(?:\.git)?", url)
        if not match:
            parsed = urllib.parse.urlsplit(url)
            if parsed.hostname != "github.com" or parsed.scheme not in {"https", "ssh"}:
                raise RuntimeError("origin must be a GitHub SSH or HTTPS remote.")
            if parsed.username not in {None, "git"} or parsed.password:
                raise RuntimeError("origin remote contains a credential; remove it from Git configuration.")
            match = re.fullmatch(r"/([^/]+)/([^/]+?)(?:\.git)?/?", parsed.path)
        if not match:
            raise RuntimeError("origin must identify one GitHub owner and repository.")
        return match.group(1), match.group(2)

    source = parse(fetch_urls[0])
    destination = parse(push_urls[0])
    if tuple(part.lower() for part in source) != tuple(part.lower() for part in destination):
        raise RuntimeError("origin fetch and push URLs target different GitHub repositories.")
    if expected is not None:
        if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", expected or ""):
            raise RuntimeError("Ship row needs a Repository value (owner/repo) in Workspace map.md.")
        if f"{source[0]}/{source[1]}".lower() != expected.lower():
            raise RuntimeError(f"origin does not match the Ship repository {expected}.")
    return source


def store_token():
    if sys.platform == "darwin":
        command = ["security", "find-generic-password", "-s", "notedbro-ship", "-a", "github", "-w"]
    elif sys.platform.startswith("linux"):
        command = ["secret-tool", "lookup", "service", "notedbro-ship", "account", "github"]
    elif sys.platform == "win32":
        try:
            import keyring
        except ImportError:
            return None
        try:
            # Select the native backend; do not accept a configured file backend.
            from keyring.backends.Windows import WinVaultKeyring
            token = WinVaultKeyring().get_password("notedbro-ship", "github")
            if token == "":
                raise RuntimeError("OS credential store has an empty Ship token; renew it or remove it.")
            return token
        except ImportError:
            return None
        except RuntimeError:
            raise
        except Exception:
            raise RuntimeError("Windows Credential Manager could not be read.") from None
    else:
        return None
    if not shutil_which(command[0]):
        return None
    try:
        result = subprocess.run(command, capture_output=True, text=True, env=child_env(), timeout=45)
    except subprocess.TimeoutExpired:
        raise RuntimeError("OS credential store did not respond.") from None
    if result.returncode == 0:
        token = result.stdout.strip()
        if not token:
            raise RuntimeError("OS credential store has an empty Ship token; renew it or remove it.")
        return token
    if result.returncode in {1, 44}:
        return None
    raise RuntimeError("OS credential store could not be read.")


def transport(vault):
    token = os.environ.get("NOTEDBRO_SHIP_TOKEN", "").strip()
    if "NOTEDBRO_SHIP_TOKEN" in os.environ and not token:
        raise RuntimeError("NOTEDBRO_SHIP_TOKEN is empty; unset it or provide a valid token.")
    if token:
        ACTIVE_SECRETS.add(token)
        return "environment", token
    token = ship_token.read_token(ship_token.token_path(), vault)
    if token:
        ACTIVE_SECRETS.add(token)
        return "file", token
    token = store_token()
    if token:
        ACTIVE_SECRETS.add(token)
        return "store", token
    if (SELF_CHECK_GH or shutil_which("gh")) and os.environ.get("BRAIN_SHIP_GH") != "0":
        return "gh", None
    raise RuntimeError(f"provide NOTEDBRO_SHIP_TOKEN, run {renewal_command()}, use a notedbro-ship OS credential, or authenticate gh.")


def api_json(token, method, endpoint, params=None, payload=None, with_expiry=False):
    url = API_ROOT + endpoint
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(payload).encode() if payload is not None else None
    request = urllib.request.Request(url, data=data, method=method, headers={
        "Accept": "application/vnd.github+json",
        "Authorization": "Bearer " + token,
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "notedbro-ship",
        **({"Content-Type": "application/json"} if data is not None else {}),
    })
    try:
        with api_open(request, timeout=15) as response:
            headers = getattr(response, "headers", {})
            expiry = expiry_from(headers)
            if expiry and expiry <= datetime.datetime.now(datetime.timezone.utc):
                raise RuntimeError(f"GitHub Ship token has expired. Renew: {renewal_command()}")
            result = json.load(response)
            return (result, expiry) if with_expiry else result
    except urllib.error.HTTPError as error:
        if error.code == 401:
            raise RuntimeError(f"GitHub token is invalid or expired. Renew: {renewal_command()}") from None
        if error.code in {403, 404}:
            raise RuntimeError("GitHub token cannot access this repository or PR operation.") from None
        raise RuntimeError(f"GitHub API request failed (HTTP {error.code}).") from None
    except (urllib.error.URLError, TimeoutError):
        raise RuntimeError("could not reach the GitHub API.") from None
    except RuntimeError:
        raise
    except Exception:
        raise RuntimeError("GitHub API returned an invalid response.") from None


def gh_json(repo, endpoint):
    result = subprocess.run([*gh_command(), "api", endpoint], cwd=str(repo), capture_output=True, text=True, env=child_env())
    if result.returncode:
        raise RuntimeError("gh authentication or repository access failed.")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        raise RuntimeError("gh returned an invalid GitHub API response.") from None


def existing_pr(pulls, owner, branch, base):
    for pull in pulls:
        if not isinstance(pull, dict):
            raise RuntimeError("GitHub returned an invalid pull-request list.")
        head = pull.get("head") or {}
        head_owner = ((head.get("repo") or {}).get("owner") or {}).get("login")
        head_owner = head_owner or (head.get("label") or "").split(":", 1)[0]
        if (head.get("ref") == branch and head_owner and head_owner.lower() == owner.lower()
                and (pull.get("base") or {}).get("ref") == base and pull.get("state") == "open"):
            return pull.get("html_url")
    return None


def preflight(vault, repo, expected, branch, base, title, body, names):
    owner, name = github_repo(repo, expected)
    method, token = transport(vault)
    endpoint = f"/repos/{urllib.parse.quote(owner)}/{urllib.parse.quote(name)}"
    query = {"state": "open", "head": owner + ":" + branch, "base": base}
    selected = [value for value in (os.environ.get(key) for key in SECRET_ENV) if value]
    if token and token not in selected:
        selected.append(token)
    for path in names:
        content_path(repo, path)
    for secret in selected:
        needle = secret.encode()
        if needle in (title + "\n" + body + "\n" + "\n".join(names)).encode() or any(
            needle in content_path(repo, path).read_bytes() for path in names if content_path(repo, path).is_file()
        ):
            raise RuntimeError("a credential appears in content selected for Ship.")
    if token:
        user, expiry = api_json(token, "GET", "/user", with_expiry=True)
        repository, repo_expiry = api_json(token, "GET", endpoint, with_expiry=True)
        pulls, pulls_expiry = api_json(token, "GET", endpoint + "/pulls", query, with_expiry=True)
        expiry = expiry or repo_expiry or pulls_expiry
    else:
        expiry = None
        user = gh_json(repo, "/user")
        repository = gh_json(repo, endpoint)
        pulls = gh_json(repo, endpoint + "/pulls?" + urllib.parse.urlencode(query))
    if not isinstance(user, dict):
        raise RuntimeError("could not confirm the authenticated GitHub account.")
    account = user.get("login")
    if not account or not isinstance(repository, dict) or repository.get("full_name", "").lower() != f"{owner}/{name}".lower():
        raise RuntimeError("could not confirm the authenticated account and target repository.")
    if not isinstance(pulls, list):
        raise RuntimeError("could not check existing pull requests.")
    public = not repository.get("private", True)
    flag = os.environ.get("BRAIN_SHIP_PUBLIC")
    if flag in {"0", "1"}:
        public = flag == "1"
    return {"method": method, "account": account, "owner": owner, "name": name,
            "public": public, "existing": existing_pr(pulls, owner, branch, base),
            "expiry": expiry, "token": token}


def create_pr(repo, auth, branch, base, title, body):
    if auth["method"] != "gh":
        endpoint = f"/repos/{urllib.parse.quote(auth['owner'])}/{urllib.parse.quote(auth['name'])}/pulls"
        created = api_json(auth["token"], "POST", endpoint,
                           payload={"head": branch, "base": base, "title": title, "body": body})
        url = created.get("html_url") if isinstance(created, dict) else None
    else:
        result = subprocess.run([
            *gh_command(), "pr", "create", "--repo", auth["owner"] + "/" + auth["name"],
            "--base", base, "--head", branch, "--title", title, "--body-file", str(pr_path()),
        ], cwd=str(repo), capture_output=True, text=True, env=child_env())
        url = result.stdout.strip() if result.returncode == 0 else None
    if not url or not url.startswith("https://github.com/"):
        raise RuntimeError("branch was pushed, but pull request creation did not return a URL.")
    return url


def restore(repo, start):
    if start and start != "HEAD":
        git(repo, "switch", start)


def fetch_base(repo, base):
    if base not in ALLOWED_BASES:
        return f"Ship withheld: unsupported base branch {base!r}. Use staging or main."
    fetched = git(repo, "fetch", "origin", check=False)
    if fetched.returncode:
        return "Ship withheld: could not fetch origin: " + safe_error(fetched.stderr.strip() or "fetch failed")
    target = "refs/remotes/origin/" + base + "^{commit}"
    if git(repo, "rev-parse", "--verify", target, check=False).returncode:
        return f"Ship withheld: origin/{base} does not exist after fetching. No fallback or base branch creation was attempted."
    return None


def push_destination_error(branch, upstream, remote_ref):
    """Validate the configured upstream and the actual refs/heads target."""
    if branch in {"main", "staging", "master"}:
        return f"refusing to push protected branch {branch}"
    expected = "refs/heads/" + branch
    if remote_ref != expected:
        return f"refusing push destination {remote_ref}; expected {expected}"
    if upstream and upstream in {"origin/main", "origin/staging", "refs/remotes/origin/main", "refs/remotes/origin/staging"}:
        return f"branch tracks protected upstream {upstream}"
    if upstream and upstream not in {"origin/" + branch, "refs/remotes/origin/" + branch}:
        return f"branch tracks unexpected upstream {upstream}"
    return None


def refspec_error(refspec):
    if ":" not in refspec:
        return None
    destination = refspec.split(":", 1)[1].lstrip("+")
    if destination in {"main", "staging", "refs/heads/main", "refs/heads/staging"}:
        return "refusing refspec that targets protected branch " + destination
    return None


def write_preview(payload):
    path = preview_path()
    pr = pr_path()
    if path.is_symlink() or pr.is_symlink():
        raise RuntimeError("Ship preview or PR body path cannot be a symlink.")
    managed = ship_token.token_path().resolve()
    if path.resolve() == managed or pr.resolve() == managed:
        raise RuntimeError("Ship preview or PR body path cannot be the token file.")
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                     prefix=".ship-preview-", delete=False) as stream:
        temp = Path(stream.name)
        os.chmod(temp, 0o600)
        json.dump(payload, stream)
    os.replace(temp, path)
    pr.parent.mkdir(parents=True, exist_ok=True)
    pr.write_text(payload["body"])


def remote_sha(repo, branch):
    ref = "refs/heads/" + branch
    result = git(repo, "ls-remote", "--heads", "origin", ref)
    lines = result.stdout.splitlines()
    if len(lines) != 1 or not lines[0].endswith("\t" + ref):
        return None
    return lines[0].split("\t", 1)[0]


def changed_work_files(repo):
    return any(line[3:] != "report.md" for line in git(repo, "status", "--porcelain", "--untracked-files=all").stdout.splitlines())


def recovery_record(vault, repo, project, base, expected):
    path = preview_path()
    if not path.is_file():
        return None
    try:
        payload = json.loads(path.read_text())
    except (ValueError, OSError):
        return None
    if (payload.get("phase") not in {"pushed", "recovery-preview"} or payload.get("project") != project
            or payload.get("repo") != str(Path(repo).resolve())):
        return None
    if payload.get("base") != base or payload.get("expected") != expected:
        raise RuntimeError("Ship configuration changed since the branch was pushed.")
    return payload


def format_preview(payload, auth, recovery=False):
    if payload.get("local_only"):
        return "\n".join([
            f"Project: {payload['project']}",
            f"Folder: {payload['folder']}",
            "Mode: local commit only",
            f"Head: {payload['branch']}",
            f"Base: {payload['base']}",
            f"Title: {payload['title']}",
            "Body:", payload["body"].rstrip(),
            "Files:", *[f"- {name}" for name in payload["names"]],
            "report.md was not available; confirmation will create the local commit only. Nothing will be pushed.",
            "Ship? fnsh ship yes",
        ])
    notice = "This PR is public." if auth["public"] else ""
    ask = "Ship? fnsh ship yes public" if auth["public"] else "Ship? fnsh ship yes"
    return "\n".join([
        f"Project: {payload['project']}",
        f"Folder: {payload['folder']}",
        f"Repository: {auth['owner']}/{auth['name']}",
        f"Authenticated account: {auth['account']}",
        f"PR transport: {TOKEN_SOURCE.get(auth['method'], 'gh')}",
        f"Head: {payload['branch']}",
        f"Base: {payload['base']}",
        f"Title: {payload['title']}",
        "Body:", payload["body"].rstrip(),
        "Files:", *[f"- {name}" for name in payload["names"]],
        "The branch is already pushed; confirmation will only create the PR." if recovery else "",
        expiry_warning(auth["expiry"]), notice, ask,
    ])


def preview(vault, repo, project, rule, folder, base, expected):
    if os.environ.get("SHIP_SCHEDULED") == "1":
        return "Ship withheld: scheduled runs cannot ship."
    if rule == "notedbro" and not publish_scan.maintainer_ready(vault, denylist_path()):
        return publish_scan.MAINTAINER_MESSAGE
    github_repo(repo, expected)
    problem = fetch_base(repo, base)
    if problem:
        return problem
    base_ref = "origin/" + base
    title, body, report_problem = report_from(repo, project, base_ref)
    if report_problem:
        return "Ship withheld: " + report_problem
    pending = recovery_record(vault, repo, project, base, expected)
    if pending:
        if (report_hash(repo) != pending["report_hash"]
                or title != pending["title"] or body != pending["body"]):
            return "Ship withheld: report.md changed since the branch was pushed. Review the pushed branch before continuing."
        if changed_work_files(repo):
            return "Ship withheld: files changed since the branch was pushed. Review the pushed branch before continuing."
        sha = pending.get("commit_sha")
        if not sha or remote_sha(repo, pending["branch"]) != sha or git(repo, "rev-parse", pending["branch"]).stdout.strip() != sha:
            return "Ship withheld: pushed branch no longer matches the reviewed commit."
        auth = preflight(vault, repo, expected, pending["branch"], base, title, body, [])
        if auth["existing"]:
            return auth["existing"]
        pending.update({"phase": "recovery-preview", "time": time.time(), "method": auth["method"],
                        "account": auth["account"], "public": auth["public"]})
        write_preview(pending)
        return format_preview(pending, auth, recovery=True)
    start = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD", check=False).stdout.strip() or "HEAD"
    names = diff_names(repo, base_ref)
    if not names:
        return "Ship withheld: nothing to ship."
    unknown, private, scans = classify(vault, repo, names, folder if rule == "branch-pr" else "")
    blocked = f"blocked: {len(unknown)} unknown paths, {len(private)} private-folder files, {len(scans)} scan hits"
    if unknown or private or scans:
        return grouped(unknown, private, scans) + "\n" + blocked
    branch = branch_name(title)
    scan_hits = publish_scan.scan_text(title + "\n" + body, publish_scan.read_terms(denylist_path()))
    if scan_hits:
        return "Ship withheld: the pull request text failed the scan.\n" + "\n".join(scan_hits) + "\n" + publish_scan.LOCAL_LINE
    local_only = report_hash(repo) == "missing"
    if local_only:
        owner, name = expected.split("/", 1)
        auth = {"method": "local", "account": "not used", "owner": owner, "name": name,
                "public": False, "existing": None, "expiry": None, "token": None}
    else:
        auth = preflight(vault, repo, expected, branch, base, title, body, names)
        if auth["existing"]:
            return auth["existing"]
    is_public = auth["public"]
    payload = {
        "project": project,
        "vault": str(vault),
        "rule": rule,
        "folder": str(folder),
        "repo": str(Path(repo).resolve()),
        "branch": branch,
        "start": start,
        "base": base,
        "hash": file_hash(repo, names),
        "names": names,
        "title": title,
        "body": body,
        "report_hash": report_hash(repo),
        "local_only": local_only,
        "public": is_public,
        "method": auth["method"],
        "account": auth["account"],
        "owner": auth["owner"],
        "name": auth["name"],
        "expected": expected,
        "phase": "preview",
        "time": time.time(),
    }
    write_preview(payload)
    return format_preview(payload, auth).replace("\n\nShip?", "\n" + blocked + "\nShip?", 1)


def apply_preview(confirm_public):
    if os.environ.get("SHIP_SCHEDULED") == "1":
        return "Ship withheld: scheduled runs cannot ship."
    path = preview_path()
    if not path.is_file():
        return "Ship withheld: no preview."
    payload = json.loads(path.read_text())
    if time.time() - payload["time"] > PREVIEW_SECONDS:
        return "Ship withheld: the preview expired."
    repo = payload["repo"]
    base = payload["base"]
    vault = payload.get("vault")
    if not vault:
        return "Ship withheld: preview has no vault configuration. Preview again."
    selected = project_rule(vault, payload["project"])
    if not selected or (selected[2], selected[3], selected[4]) != (
            payload["folder"], base, payload.get("expected")):
        return "Ship withheld: Ship configuration changed. Preview again."
    github_repo(repo, payload["expected"])
    problem = fetch_base(repo, base)
    if problem:
        return problem
    base_ref = "origin/" + base
    title, body, report_problem = report_from(repo, payload["project"], base_ref)
    if report_problem:
        return "Ship withheld: " + report_problem
    current_report_hash = report_hash(repo)
    if current_report_hash != payload.get("report_hash") or title != payload["title"] or body != payload["body"]:
        return "Ship withheld: report.md changed. Preview again."
    recovering = payload.get("phase") == "recovery-preview"
    names = [] if recovering else diff_names(repo, base_ref)
    if not recovering and file_hash(repo, names) != payload["hash"]:
        return "Ship withheld: the files changed. Ship again."
    if payload["branch"] in {"main", "staging", "master"}:
        return "Ship withheld: refusing to push a protected base branch."
    if payload.get("public") and not confirm_public:
        return "This PR is public.\nShip? fnsh ship yes public"
    unknown, private, scans = classify(vault, repo, names, payload["folder"] if payload["rule"] == "branch-pr" else "")
    if unknown or private or scans:
        return grouped(unknown, private, scans)
    if payload.get("local_only"):
        auth = None
    else:
        auth = preflight(vault, repo, payload["expected"], payload["branch"], base, title, body, names)
        if (auth["method"], auth["account"], auth["owner"], auth["name"], auth["public"]) != (
            payload["method"], payload["account"], payload["owner"], payload["name"], payload["public"]
        ):
            return "Ship withheld: authentication or repository visibility changed. Preview again."
        if auth["existing"]:
            return auth["existing"]
    if recovering:
        sha = payload.get("commit_sha")
        if changed_work_files(repo) or not sha or (
                remote_sha(repo, payload["branch"]) != sha
                or git(repo, "rev-parse", payload["branch"]).stdout.strip() != sha):
            return "Ship withheld: pushed branch or working files changed. Preview again."
        try:
            url = create_pr(repo, auth, payload["branch"], base, title, body)
        except (RuntimeError, OSError, ValueError) as error:
            return f"Ship withheld: branch {payload['branch']} was pushed, but PR creation failed: {safe_error(str(error))}"
        return url
    saved = {}
    for name in names:
        path = content_path(repo, name)
        saved[name] = path.read_bytes() if path.is_file() else None
    existing_branch = git(repo, "show-ref", "--verify", "--quiet", "refs/heads/" + payload["branch"], check=False).returncode == 0
    if existing_branch:
        return "Ship withheld: work branch already exists; refusing to replace it."
    git(repo, "switch", "-c", payload["branch"], "--no-track", base_ref)
    for name, data in saved.items():
        path = content_path(repo, name)
        if data is None:
            if path.exists():
                path.unlink()
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
    git(repo, "add", "--", *names)
    git(repo, "commit", "-m", payload["title"], "-m", payload["body"])
    payload["commit_sha"] = git(repo, "rev-parse", "HEAD").stdout.strip()
    if payload.get("local_only"):
        payload["phase"] = "local-only"
        try:
            write_preview(payload)
        except (RuntimeError, OSError, ValueError):
            pass
        return (
            f"Ship withheld: report.md was unavailable. Commit {payload['commit_sha']} remains local "
            f"on branch {payload['branch']}; nothing was pushed. Review it and push manually."
        )
    upstream = git(repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}", check=False).stdout.strip()
    destination = "refs/heads/" + payload["branch"]
    safety = push_destination_error(payload["branch"], upstream, destination)
    if safety:
        return (
            f"Ship withheld: commit {payload['commit_sha']} remains local on branch "
            f"{payload['branch']}; nothing was pushed. Review it and push manually. "
            f"Push refused: {safety}."
        )
    unsafe = refspec_error(destination)
    if unsafe:
        return (
            f"Ship withheld: commit {payload['commit_sha']} remains local on branch "
            f"{payload['branch']}; nothing was pushed. Review it and push manually. "
            f"Push refused: {unsafe}."
        )
    payload["phase"] = "ready-to-push"
    try:
        write_preview(payload)
    except (RuntimeError, OSError, ValueError) as error:
        return (
            f"Ship withheld: commit {payload['commit_sha']} remains local on branch "
            f"{payload['branch']}; nothing was pushed. Review it and push manually. "
            f"Ship state could not be saved: {safe_error(str(error))}"
        )
    try:
        git(repo, "push", "-u", "origin", payload["branch"])
    except (RuntimeError, OSError, ValueError) as error:
        return (
            f"Ship withheld: commit {payload['commit_sha']} remains local on branch "
            f"{payload['branch']}; push was not completed. Review it and push manually. "
            f"Push failed: {safe_error(str(error))}"
        )
    payload["phase"] = "pushed"
    try:
        write_preview(payload)
    except (RuntimeError, OSError, ValueError) as error:
        return f"Ship withheld: branch {payload['branch']} was pushed, but recovery state could not be saved: {safe_error(str(error))}"
    try:
        restore(repo, payload["start"])
        url = create_pr(repo, auth, payload["branch"], base, payload["title"], payload["body"])
    except (RuntimeError, OSError, ValueError) as error:
        return f"Ship withheld: branch {payload['branch']} was pushed, but PR creation failed: {safe_error(str(error))}"
    return url


def resolve(argv, vault):
    try:
        return _resolve(argv, vault)
    except (RuntimeError, OSError, ValueError) as error:
        return "Ship withheld: " + safe_error(str(error))


def _resolve(argv, vault):
    if os.environ.get("SHIP_SCHEDULED") == "1":
        return "Ship withheld: scheduled runs cannot ship."
    if argv[:1] == ["yes"]:
        return apply_preview(len(argv) > 1 and argv[1] == "public")
    project = argv[0] if argv else ""
    found = workspace_map.load_map(vault)
    match = None
    for name, rule, folder, base, expected in found.get("ships", []):
        if not project or name.lower() == project.lower():
            match = (name, rule, folder, base, expected)
            if project:
                break
    if project and (not match or match[0].lower() != project.lower()):
        return f"Ship withheld: no rule for {project}."
    if not match:
        return "Ship withheld: no rule for this project."
    name, rule, folder, base, expected = match
    if rule == "notedbro" and not publish_scan.maintainer_ready(vault, denylist_path()):
        return publish_scan.MAINTAINER_MESSAGE
    repo = folder
    if not Path(repo).is_dir():
        return f"Ship withheld: no folder for {name}."
    return preview(vault, repo, name, rule, folder, base, expected)


def token_command(action, vault):
    path = ship_token.token_path()
    if action == "setup":
        def validate(token):
            user, expiry = api_json(token, "GET", "/user", with_expiry=True)
            account = user.get("login") if isinstance(user, dict) else None
            if not account:
                raise RuntimeError("GitHub did not identify the token account.")
            return account, expiry_display(expiry)
        return ship_token.setup(path, vault, validate)
    if action == "status":
        method, token = transport(vault)
        if token:
            user, expiry = api_json(token, "GET", "/user", with_expiry=True)
        else:
            user, expiry = gh_json(vault, "/user"), None
        account = user.get("login") if isinstance(user, dict) else None
        if not account:
            raise RuntimeError("could not confirm the authenticated GitHub account.")
        return f"Ship token source: {TOKEN_SOURCE.get(method, 'gh')}. Account: {account}. Expiry: {expiry_display(expiry)}."
    if action == "remove":
        result = ship_token.remove(path, vault)
        if result.startswith("Managed Ship token file removed"):
            if os.environ.get("NOTEDBRO_SHIP_TOKEN", "").strip():
                return result + " NOTEDBRO_SHIP_TOKEN remains active."
            try:
                if store_token():
                    return result + " An OS credential remains available."
            except RuntimeError:
                return result + " OS credential store availability could not be checked."
            if shutil_which("gh"):
                return result + " gh may remain available if authenticated."
            return result + " No other Ship credential was found."
        return result
    return "Usage: ship token setup|status|remove."


