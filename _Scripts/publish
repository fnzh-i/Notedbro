def gitignore_text(vault=None):
    """Star-ignore, then descend, then un-ignore only manifest paths."""
    files, dirs = publish_scan.read_manifest(vault or VAULT)
    lines = [
        "# Notes stay on your machine. Only starter-kit paths are tracked.",
        "*",
        "!*/",
    ]
    for folder in dirs:
        lines.append("!/" + folder)
        lines.append("!/" + folder + "**")
    for name in files:
        if any(name.startswith(folder) for folder in dirs):
            continue
        parts = name.split("/")
        for depth in range(1, len(parts)):
            lines.append("!/" + "/".join(parts[:depth]) + "/")
        lines.append("!/" + name)
    lines += [
        "/_Scripts/host-restore/",
        "/Workspace map.md",
        "/.claude/settings.local.json",
        "/.claude/hooks/notedbro.py",
        "/.notedbro-local/",
        "*.canvas",
        "*.jsonl",
        ".DS_Store",
        ".env",
        "*.pem",
        "*.age",
        "shadow.key",
        "__pycache__/",
        "# >>> brain-guard",
        "# <<< brain-guard",
    ]
    return "\n".join(lines) + "\n"


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    # Keep generated files byte-stable across platforms.  In particular,
    # Windows text mode otherwise expands LF to CRLF, making the UTF-8
    # regression probe depend on the runner rather than the encoding.
    with path.open("w", encoding="utf-8", newline="\n") as handle:
        handle.write(text)


def public_main(out):
    """Return the local public main tree, never fetching or contacting a network."""
    def git_out(*args):
        return subprocess.run(["git", "-C", str(out), *args], capture_output=True, text=True)
    if not (out / ".git").exists():
        raise RuntimeError("Public-owned source is missing; refresh the local public checkout first.")
    origin = git_out("rev-parse", "--verify", "refs/remotes/origin/main^{commit}")
    local = git_out("rev-parse", "--verify", "refs/heads/main^{commit}")
    if origin.returncode or local.returncode or origin.stdout.strip() != local.stdout.strip():
        raise RuntimeError("Public-owned source is stale; refresh local origin/main and fast-forward main before publishing.")
    return origin.stdout.strip()


def copy_public_owned(out, dest):
    commit = public_main(out)
    for rel in PUBLIC_OWNED:
        entry = subprocess.run(["git", "-C", str(out), "ls-tree", commit, "--", rel], capture_output=True, text=True)
        fields = entry.stdout.rstrip("\n").split("\t", 1)
        if entry.returncode or len(fields) != 2 or not fields[0].startswith("100"):
            raise RuntimeError(f"Public-owned file is missing or a link: {rel}. Refresh the local public checkout.")
        blob = subprocess.run(["git", "-C", str(out), "show", f"{commit}:{rel}"], capture_output=True)
        if blob.returncode:
            raise RuntimeError(f"Could not read public-owned file: {rel}.")
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(blob.stdout)
        if fields[0].startswith("100755"):
            target.chmod(0o755)


def unexpected_deletions(out, dest):
    commit = public_main(out)
    tracked = subprocess.run(["git", "-C", str(out), "ls-tree", "-r", "--name-only", commit], capture_output=True, text=True)
    if tracked.returncode:
        return ["could not list local public main"]
    return [rel for rel in tracked.stdout.splitlines() if not (dest / rel).is_file()]


def build_tree(vault, dest, out=None):
    """Copy the include list and write the generated files. Returns missing entries."""
    files, missing = included(vault)
    if out is not None:
        copy_public_owned(out, dest)
    for rel in files:
        if out is not None and rel.as_posix() in PUBLIC_OWNED:
            continue
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(vault / rel, target)
    template = (dest / "_Templates" / "Area.md")
    area = template.read_text(encoding="utf-8") if template.is_file() else "---\ntags: [area]\n---\n# {{title}}\n\nBack to [[Index]].\n"
    for folder, title in HUBS:
        write(dest / folder / f"{title}.md", hub_text(area, title, folder))
    write(dest / "Personal" / "Chats" / "Chats.md", chats_text())
    write(dest / "Index.md", index_text())
    example = dest / "_Templates" / "Workspace map.md"
    if example.is_file() and (out is None or "Workspace map.example.md" not in PUBLIC_OWNED):
        write(dest / "Workspace map.example.md", example.read_text(encoding="utf-8"))
    elif not example.is_file():
        missing.append("_Templates/Workspace map.md")
    if out is None or ".gitignore" not in PUBLIC_OWNED:
        write(dest / ".gitignore", gitignore_text(vault))
    bootstrap = load_script("build-bootstrap")
    write(dest / "_Config" / "bootstrap.md", bootstrap.render(dest))
    runtime = load_script("build-runtime-manifest")
    runtime.write_manifest(dest)
    if out is not None:
        missing += [name + " (would be deleted from public main)" for name in unexpected_deletions(out, dest)]
    return missing


