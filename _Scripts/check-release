#!/usr/bin/env python3
"""Run the full maintainer release gate against the checkout and a clean export."""
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
PYTHON = sys.executable

FULL_CHECKS = (
    ("runtime manifest", (PYTHON, "_Scripts/build-runtime-manifest", "--check")),
    ("historical baseline", (PYTHON, "_Scripts/check-migration", "verify-baseline")),
    ("onboarding", (PYTHON, "_Scripts/check-onboarding")),
)

CLEAN_CHECKS = (
    ("documentation", (PYTHON, "_Scripts/check-docs")),
    ("exported onboarding", (PYTHON, "_Scripts/check-onboarding")),
    ("collaboration", (PYTHON, "_Scripts/check-collaboration")),
    ("file-session", (PYTHON, "_Scripts/check-file-session")),
    ("provenance tags", (PYTHON, "_Scripts/check-provenance-tags")),
    ("vault", (PYTHON, "_Scripts/check-vault")),
    ("guard self-check", (PYTHON, "_Scripts/guard", "self-check")),
    ("upgrade self-check", (PYTHON, "_Scripts/upgrade", "self-check")),
    ("publish self-check", (PYTHON, "_Scripts/publish", "self-check")),
    ("sync self-check", (PYTHON, "_Scripts/sync", "self-check")),
    ("rebuild self-check", (PYTHON, "_Scripts/rebuild", "self-check")),
    ("shadow self-check", (PYTHON, "_Scripts/shadow", "self-check")),
    ("ship self-check", (PYTHON, "_Scripts/ship", "self-check")),
)


def run(label, command, root):
    print(f"==> {label}", flush=True)
    env = dict(os.environ, BRAIN_VAULT=str(root), PYTHONDONTWRITEBYTECODE="1")
    result = subprocess.run(command, cwd=str(root), env=env)
    if result.returncode:
        raise SystemExit(f"check-release: {label} failed with exit code {result.returncode}")


def tracked_files(root):
    result = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-z", "--cached"],
        capture_output=True,
    )
    if result.returncode:
        raise SystemExit("check-release: a full Git checkout is required")
    return [Path(os.fsdecode(raw)) for raw in result.stdout.split(b"\0") if raw]


def export_tracked(root, destination):
    for rel in tracked_files(root):
        source = root / rel
        target = destination / rel
        if source.is_symlink():
            target.parent.mkdir(parents=True, exist_ok=True)
            target.symlink_to(os.readlink(source))
        elif source.is_file():
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
        else:
            raise SystemExit(f"check-release: tracked path is missing or unsupported: {rel.as_posix()}")


def main():
    for label, command in FULL_CHECKS:
        run(label, command, ROOT)
    print("check-release: full checkout passed", flush=True)

    with tempfile.TemporaryDirectory(prefix="notedbro-release-") as raw:
        exported = Path(raw) / "release"
        export_tracked(ROOT, exported)
        for label, command in CLEAN_CHECKS:
            run(label, command, exported)
    print("check-release: clean tracked export passed")


if __name__ == "__main__":
    main()
