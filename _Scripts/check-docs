#!/usr/bin/env python3
"""Check shipped documentation links, CLI examples, and template-copy CI guards."""
from pathlib import Path
import re
from urllib.parse import unquote

ROOT = Path(__file__).resolve().parent.parent


def check(root=ROOT):
    problems = []
    docs = [p for p in root.rglob("*.md") if not any(part in (".git", ".notedbro-local", "host-restore", "__pycache__") for part in p.parts)]
    for path in docs:
        text = path.read_text(errors="replace")
        for target in re.findall(r"!?\[[^\]]*\]\(([^)]+)\)", text):
            if re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:", target) or target.startswith("#"):
                continue
            dest = path.parent / unquote(target.split("#", 1)[0].strip("<>"))
            if not dest.exists():
                problems.append(f"{path.relative_to(root)}: missing link {target}")
        if path.name not in ("Migration 1.1.0.md", "Change report 1.1.0.md"):
            if re.search(r"(?<![\w/])(?:Templates/Session\.md|Scripts/file-session)", text):
                problems.append(f"{path.relative_to(root)}: obsolete literal path")
        for span in re.findall(r"`([^`\n]+)`", text):
            if any(x in span for x in ("<", ">", "*", "{", "}")):
                continue
            for rel in re.findall(r"(?<![\w/])(?:_Scripts|_Templates)/[A-Za-z0-9_.-]+", span):
                if rel == "_Scripts/host-restore":
                    continue
                if not (root / rel).exists() and not (root / span).exists():
                    problems.append(f"{path.relative_to(root)}: missing literal path {rel}")
    for path in (root / ".github/workflows").glob("*.y*ml"):
        text = path.read_text()
        jobs = re.findall(r"(?m)^  ([A-Za-z0-9_-]+):\s*\n(.*?)(?=^  [A-Za-z0-9_-]+:|\Z)", text.split("jobs:", 1)[-1], re.S)
        if not jobs:
            problems.append(f"{path.name}: no guarded jobs found")
        for name, block in jobs:
            if not re.search(r"(?m)^    if: github\.repository == 'fnzh-i/Notedbro'\s*$", block):
                problems.append(f"{path.name}: {name} lacks the upstream-only job guard")
    readme = (root / "README.md").read_text()
    if "Use this template" not in readme or "Private" not in readme or "cd ~/Documents/Brain" not in readme:
        problems.append("README: incomplete private-template quick start")
    for script in ("setup", "check-migration", "check-onboarding"):
        if not (root / "_Scripts" / script).is_file():
            problems.append(f"Missing documented command: {script}")
    return problems


if __name__ == "__main__":
    errors = check()
    if errors:
        raise SystemExit("\n".join(errors))
    print("check-docs: links, command paths, private-template quick start, and CI job guards passed")
