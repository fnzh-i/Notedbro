    def test_private_publication_and_staging(self):
        self.run_setup("claude")
        subprocess.run(["git", "init", "-q", str(self.root)], check=True)
        subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)
        names = subprocess.check_output(["git", "-C", str(self.root), "ls-files"]).decode()
        self.assertNotIn(".claude/settings.local.json", names)
        self.assertNotIn(".notedbro-local/", names)
        pub = module(self.root / "_Scripts/publish")
        selected, missing = pub.included(self.root)
        self.assertFalse(any(str(p).startswith((".claude/", ".notedbro-local/")) for p in selected))
        # An erroneous future manifest must still not publish generated local settings.
        manifest = self.root / "_Scripts/starter-manifest.txt"
        manifest.write_text(manifest.read_text() + ".claude/\n.notedbro-local/\n")
        selected, _ = pub.included(self.root)
        self.assertFalse(any(str(p) in (".claude/settings.local.json", ".claude/hooks/notedbro.py") or str(p).startswith(".notedbro-local/") for p in selected))

