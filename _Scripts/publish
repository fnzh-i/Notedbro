        allow_product_paths={
            "CHANGELOG.md", "DESIGN.md", "README.md", "Prefixes.md", "How to use the brain.md",
            "_Config/bootstrap.md", "How to set up.md", "Prerequisites.md", "SECURITY.md", "CONTRIBUTING.md",
