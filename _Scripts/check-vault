#!/usr/bin/env python3
"""Check that the vault still follows its own rules."""

import ast
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from vault_path import vault_root  # noqa: E402
import publish_scan  # noqa: E402

VAULT = vault_root()
REQUIRED = (
    "Index.md",
    "How this vault works.md",
    "Prefixes.md",
    "Parameters.md",
    "Preferences.md",
    "Hosts.md",
    "Terms.md",
    "_Templates/Session.md",
    "_Templates/Plan.md",
    "_Scripts/file-session",
    "_Scripts/load-host",
    "_Config/bootstrap.md",
)
SKIP = {".git", ".obsidian", "Skill files", "_Scripts", "_Templates", "_Config"}
# Repository docs read on GitHub: plain markdown, no frontmatter, no wiki links.
REPO_DOCS = {
    "README.md", "Prerequisites.md", "How to set up.md", "SECURITY.md", "CONTRIBUTING.md",
    "DESIGN.md", "CHANGELOG.md", "CODE_OF_CONDUCT.md", "AGENTS.md", "CLAUDE.md",
}
RECORD_DIRS = {"Sessions", "Daily", "Decisions", "Commits"}
# Host and harness files, by the host name fnsh rebuild takes.
HOST_FILES = {
    "cursor": ("Hosts/Cursor.md",),
    "claude": ("Hosts/Claude.md", "CLAUDE.md"),
    "codex": ("Hosts/Codex.md", "AGENTS.md"),
    "web": ("Hosts/Web.md",),
    "unknown": ("Hosts/Unknown.md",),
}
ACTION_WORDS = re.compile(r"^ACTION_WORDS\s*=\s*(\{[^}]*\})", re.M)
FRONTMATTER = re.compile(r"\A---\r?\n(.*?)\r?\n---", re.S)
INLINE_TAGS = re.compile(r"(?m)^tags:[ \t]*\[([^\]]*)\][ \t]*$")
TAGS_KEY = re.compile(r"(?m)^tags:")
HASH_LINE = re.compile(r"(?m)^sources-sha256:[ \t]*([0-9a-f]{64})[ \t]*$")
WIKI_LINK = re.compile(r"(?<!!)\[\[([^\]]+)\]\]")
FENCE = re.compile(r"```.*?```", re.S)
INLINE_CODE = re.compile(r"`[^`\n]*`")


def scalar(frontmatter, key):
    matches = re.findall(rf"(?m)^{re.escape(key)}:[ \t]*(.*)$", frontmatter)
    if not matches:
        return None
    return matches[0].strip().strip("\"'")


def tags_of(frontmatter):
    match = INLINE_TAGS.search(frontmatter)
    if not match:
        return []
    return [part.strip() for part in match.group(1).split(",") if part.strip()]


def load_bootstrap():
    path = Path(__file__).with_name("build-bootstrap")
    loader = importlib.machinery.SourceFileLoader("build_bootstrap", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def link_indexes(vault):
    stems = set()
    paths = set()
    for dirpath, dirnames, filenames in os.walk(vault):
        dirnames[:] = [name for name in dirnames if name not in {".git", ".obsidian", "Skill files"} and not name.startswith(".")]
        for name in filenames:
            path = Path(dirpath) / name
            if path.suffix.lower() not in {".md", ".canvas"}:
                continue
            rel = path.relative_to(vault).as_posix()
            stems.add(path.stem)
            paths.add(rel[: -len(path.suffix)])
    return stems, paths


def resolves(target, stems, paths):
    target = target.strip()
    if target.lower().endswith(".md"):
        target = target[:-3]
    if "/" in target:
        return target in paths
    return target in stems


def prose(body):
    return INLINE_CODE.sub("", FENCE.sub("", body))


def host_file_state(vault, rel):
    """'missing', 'damaged', or '' for one host or harness file."""
    path = vault / rel
    if not path.is_file():
        return "missing"
    text = path.read_text(errors="replace")
    if not text.strip():
        return "damaged"
    if rel == "CLAUDE.md":
        return "" if "AGENTS.md" in text else "damaged"
    if rel == "AGENTS.md":
        return "" if "Prefixes.md" in text and "Prerequisites.md" in text else "damaged"
    if "[[Hosts]]" not in text:
        return "damaged"
    if rel == "Hosts/Web.md" and not ("<!-- brain:start -->" in text and "<!-- brain:end -->" in text):
        return "damaged"
    return ""


def host_problems(vault):
    problems = []
    for host, files in HOST_FILES.items():
        for rel in files:
            state = host_file_state(vault, rel)
            if state:
                problems.append(f"{rel}: {state}. Run fnsh rebuild {host}")
    return problems


def action_words(vault):
    path = vault / "_Scripts" / "file-session"
    if not path.is_file():
        return set()
    match = ACTION_WORDS.search(path.read_text(errors="replace"))
    return set(ast.literal_eval(match.group(1))) if match else set()


def prefix_problems(vault):
    path = vault / "Prefixes.md"
    if not path.is_file():
        return []
    text = path.read_text(errors="replace")
    problems = []
    for word in sorted(action_words(vault)):
        if not re.search(rf"(?m)^\| fnsh {re.escape(word)}\b", text):
            problems.append(f"Prefixes.md: no row for fnsh {word}")
    templates = vault / "_Templates"
    if templates.is_dir():
        for template in sorted(templates.glob("*.md")):
            if f"_Templates/{template.stem}" not in text:
                problems.append(f"Prefixes.md: template not listed: _Templates/{template.stem}")
    return problems


def check(vault=VAULT):
    problems = []
    for name in REQUIRED:
        if not (vault / name).is_file():
            problems.append(f"missing file: {name}")
    problems += host_problems(vault)
    problems += prefix_problems(vault)

    bootstrap = vault / "_Config" / "bootstrap.md"
    if bootstrap.is_file():
        try:
            module = load_bootstrap()
            digest = module.source_digest(vault)
        except OSError as error:
            problems.append(f"_Config/bootstrap.md: cannot hash sources ({error})")
            digest = ""
        match = HASH_LINE.search(bootstrap.read_text())
        if not match:
            problems.append("_Config/bootstrap.md: missing sources-sha256")
        elif digest and match.group(1) != digest:
            problems.append("_Config/bootstrap.md: stale bootstrap")

    stems, paths = link_indexes(vault)
    for dirpath, dirnames, filenames in os.walk(vault):
        dirnames[:] = [name for name in dirnames if name not in SKIP and not name.startswith(".")]
        for name in filenames:
            if not name.endswith(".md"):
                continue
            path = Path(dirpath) / name
            rel = path.relative_to(vault)
            if rel.as_posix() in REPO_DOCS:
                continue
            text = path.read_text(errors="replace")
            front = FRONTMATTER.match(text)
            if not front or not TAGS_KEY.search(front.group(1)):
                problems.append(f"{rel.as_posix()}: missing tags")
                frontmatter = front.group(1) if front else ""
                tags = []
            else:
                frontmatter = front.group(1)
                tags = tags_of(frontmatter)
            parts = set(rel.parts)
            in_record = bool(parts & RECORD_DIRS)
            if "temporal" in tags and not in_record:
                problems.append(f"{rel.as_posix()}: temporal note outside a record folder")
            if in_record and "temporal" not in tags:
                problems.append(f"{rel.as_posix()}: record folder missing temporal")
            if "plan" in tags and rel.parts[0] != "Plans":
                problems.append(f"{rel.as_posix()}: plan note outside Plans/")
            needs_provenance = ("plan" in tags) or ("Sessions" in rel.parts and scalar(frontmatter, "conversation") is not None)
            if needs_provenance:
                for key in ("host", "model", "date"):
                    if not scalar(frontmatter, key):
                        problems.append(f"{rel.as_posix()}: missing {key}")
            if not front:
                continue
            seen = set()
            for link in WIKI_LINK.finditer(prose(text[front.end():])):
                raw = link.group(1)
                target = raw.split("|", 1)[0].split("#", 1)[0].strip()
                if not target or target in seen:
                    continue
                seen.add(target)
                if not resolves(target, stems, paths):
                    problems.append(f"{rel.as_posix()}: unresolved [[{target}]]")
    return problems


def notedbro_version():
    path = Path(__file__).with_name("notedbro-version")
    return path.read_text(errors="replace").strip() if path.is_file() else "0"


def manifest_warnings(vault):
    """Warn when a tracked file was shared but left off the starter manifest."""
    files, dirs = publish_scan.read_manifest(vault)
    result = subprocess.run(
        ["git", "-C", str(vault), "ls-files"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        return []
    warnings = []
    for rel in result.stdout.splitlines():
        if publish_scan.in_manifest(rel, files, dirs) or publish_scan.is_private_path(rel):
            continue
        warnings.append(f"Not in manifest: {rel}")
    return warnings


def main():
    try:
        path = Path(__file__).with_name("guard")
        loader = importlib.machinery.SourceFileLoader("guard_script", str(path))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        result = module.run(VAULT, verbose=False)
        if result["text"]:
            print(result["text"])
    except Exception:
        pass
    problems = check()
    denylist = Path(os.path.expanduser(os.environ.get("BRAIN_PUBLISH_DENYLIST", "~/.config/brain/publish-denylist")))
    if not publish_scan.maintainer_ready(VAULT, denylist):
        problems = [item for item in problems if "fnsh publish" not in item and "fnsh sync" not in item]
    problems += manifest_warnings(VAULT)
    if problems:
        print("\n".join(problems))
        raise SystemExit(1)
    print(f"Vault ok. Notedbro v{notedbro_version()}.")


if __name__ == "__main__":
    main()
