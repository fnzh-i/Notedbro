#!/usr/bin/env python3
"""Compare an installation with the shipped v1.0.0 baseline, without writes."""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import migration

if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["verify-baseline"]:
            print(f"Historical manifest verified: {migration.verify_baseline()} files.")
        elif len(sys.argv) == 2:
            raise SystemExit(migration.report(sys.argv[1]))
        else:
            raise SystemExit("Usage: python3 _Scripts/check-migration <existing-folder> | verify-baseline")
    except (ValueError, OSError) as error:
        raise SystemExit(f"Migration check failed: {error}")
