    def test_checksum_states_and_safety(self):
        builder = module(self.root / "_Scripts/build-runtime-manifest")
        self.assertFalse(builder.problems(self.root))
        runtime = self.root / "_Scripts/publish"
        runtime.write_text(runtime.read_text(encoding="utf-8") + "# stale runtime\n", encoding="utf-8")
        self.assertEqual(builder.problems(self.root), ["Runtime checksum mismatch: _Scripts/publish"])

        old = self.base / "existing"
        old.mkdir()
        stock = subprocess.run(["git", "-C", str(SOURCE), "archive", migration.BASE_COMMIT], capture_output=True)
        if stock.returncode:
            self.skipTest("Historical Git objects not available; run verify-baseline in full checkout")
        import io, tarfile
        with tarfile.open(fileobj=io.BytesIO(stock.stdout)) as archive:
            archive.extractall(old)
        before = (old / "Parameters.md").read_bytes()
        rows = migration.compare(old)
        self.assertIn("stock v1.0.0", {r["state"] for r in rows})
        self.assertIn("already current", {r["state"] for r in rows})
        self.assertIn("missing", {r["state"] for r in rows})
        tool = old / "_Scripts/guard"
        tool.write_text(tool.read_text() + "# custom\n")
        (old / "_Scripts/custom-script").write_text("custom")
        (old / "_Scripts/upgrade").unlink()
        (old / "_Scripts/upgrade").symlink_to(SOURCE / "_Scripts/upgrade")
        rows = migration.compare(old)
        states = {r["path"]: r for r in rows}
        self.assertEqual(states["_Scripts/guard"]["state"], "modified")
        self.assertEqual(states["_Scripts/upgrade"]["state"], "unknown")
        self.assertEqual(states["_Scripts/custom-script"]["state"], "unknown")
        self.assertEqual((old / "Parameters.md").read_bytes(), before)
        self.assertFalse(states["Parameters.md"]["copy"])
        self.assertFalse(states["_Scripts/notedbro-version"]["copy"])

    def test_stock_migration_and_version_gate(self):
        old = self.base / "v100"
        old.mkdir()
        archive = subprocess.run(["git", "-C", str(SOURCE), "archive", migration.BASE_COMMIT], capture_output=True)
        if archive.returncode:
            self.skipTest("Historical Git objects unavailable")
        import io, tarfile
        with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as tree:
            tree.extractall(old)
        (old / "Workspace map.md").write_text("---\ntags: [meta]\n---\n# My routing\n")
        params = (old / "Parameters.md").read_bytes()
        for row in migration.compare(old):
            if row["copy"]:
                destination = old / row["path"]
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(SOURCE / row["path"], destination)
        env = dict(self.env, BRAIN_VAULT=str(old))
        result = subprocess.run([sys.executable, str(SOURCE / "_Scripts/setup"), "claude", "home", str(self.home)], env=env, capture_output=True, text=True)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual((old / "_Scripts/notedbro-version").read_text(), "1.1.0\n")
        self.assertEqual((old / "Parameters.md").read_bytes(), params)
        self.assertEqual((old / "Workspace map.md").read_text(), "---\ntags: [meta]\n---\n# My routing\n")
        (old / "_Scripts/notedbro-version").write_text("1.0.0\n")
        (old / "_Scripts/file-session").write_text("# unresolved custom filer\n")
        result = subprocess.run([sys.executable, str(SOURCE / "_Scripts/setup"), "claude", "home", str(self.home)], env=env, capture_output=True, text=True)
        self.assertEqual(result.returncode, 1)
        self.assertEqual((old / "_Scripts/notedbro-version").read_text(), "1.0.0\n")


