class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, msg, headers, newurl):
        return None


def api_open(request, timeout):
    return urllib.request.build_opener(NoRedirect()).open(request, timeout=timeout)


def renewal_command():
    return "py _Scripts/ship token setup" if sys.platform == "win32" else "python3 _Scripts/ship token setup"


def expiry_from(headers):
    value = headers.get("GitHub-Authentication-Token-Expiration") if headers else None
    if not value:
        return None
    try:
        try:
            instant = email.utils.parsedate_to_datetime(value)
        except (ValueError, TypeError):
            instant = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
        if instant.tzinfo is None:
            instant = instant.replace(tzinfo=datetime.timezone.utc)
        return instant.astimezone(datetime.timezone.utc)
    except (ValueError, TypeError, OverflowError):
        return None


def expiry_display(expiry):
    return expiry.date().isoformat() if expiry else "unknown"


def expiry_warning(expiry):
    if expiry and expiry - datetime.datetime.now(datetime.timezone.utc) <= datetime.timedelta(days=5):
        return f"Ship token expires {expiry_display(expiry)}. Renew: {renewal_command()}"
    return ""


def child_env():
    """Do not expose any Ship or CI token to git, gh, or store helpers."""
    return {key: value for key, value in os.environ.items() if key not in SECRET_ENV}


def safe_error(message):
    """Avoid echoing credentials from Git or HTTP error text."""
    for key in SECRET_ENV:
        secret = os.environ.get(key)
        if secret:
            message = message.replace(secret, "[redacted]")
    for secret in ACTIVE_SECRETS:
        message = message.replace(secret, "[redacted]")
    message = re.sub(r"(?i)(https?://)[^/@\s]+@", r"\1[redacted]@", message)
    return message


def preview_path():
    return Path(os.path.expanduser(os.environ.get("BRAIN_SHIP_PREVIEW", "~/.local/share/brain/ship-preview.json")))


def pr_path():
