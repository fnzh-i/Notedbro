    def global_hook(self, filer, kind="legacy"):
        path = self.home / ".claude/hooks/brain-reminder.py"
        path.parent.mkdir(parents=True, exist_ok=True)
        loader = module(self.root / "_Scripts/load-host")
        # Exact v1.0.0 wrapper shape with a statically resolvable relocated filer.
        text = loader.THIN_HOOK.format(kind="Session-end", hook="claude")
        text = text.replace('os.path.expanduser("~/Documents/Brain/_Scripts/file-session")', repr(str(filer)))
        path.write_text(text)
        settings = self.home / ".claude/settings.json"
        settings.write_text(json.dumps({"hooks": {"SessionEnd": [{"hooks": [{"type": "command", "command": "python3 -I " + __import__('shlex').quote(str(path))}]}]}}))
        return path, settings

